<section class="testimonials-section" style="padding: {{ section.settings.section_padding }}px 5%; background: {{ section.settings.background_color }};">
  <div class="testimonials-container">
    <div class="section-header">
      <div class="section-kicker">{{ section.settings.kicker }}</div>
      <h2 class="section-title">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle %}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="testimonials-grid">
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' %}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-header">
              <div class="testimonial-author-info">
                <span class="testimonial-author">{{ block.settings.author }}</span>
                <span class="testimonial-location">{{ block.settings.location }}</span>
              </div>
              {% if block.settings.show_verified %}
                <span class="verified-badge">{{ block.settings.verified_text }}</span>
              {% endif %}
            </div>

            <div class="stars">
              {% assign star_count = block.settings.rating %}
              {% for i in (1..5) %}
                {% if i <= star_count %}⭐{% endif %}
              {% endfor %}
            </div>

            <p class="testimonial-text">"{{ block.settings.testimonial }}"</p>

            {% if block.settings.use_case %}
              <p class="testimonial-usecase">{{ block.settings.use_case }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding: 80px 5%;
  }

  .testimonials-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-kicker {
    font-size: 12px;
    letter-spacing: 2px;
    color: {{ section.settings.kicker_color }};
    font-weight: 700;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    margin: 0 0 16px 0;
    letter-spacing: -0.5px;
  }

  .section-subtitle {
    font-size: 18px;
    color: {{ section.settings.subtitle_color }};
    line-height: 1.6;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
  }

  .testimonial-card {
    background: {{ section.settings.card_bg_color }};
    padding: 32px;
    border-radius: 16px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transition: all 0.3s;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  }

  .testimonial-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
  }

  .testimonial-author-info {
    display: flex;
    flex-direction: column;
  }

  .testimonial-author {
    font-size: 16px;
    font-weight: 700;
    color: {{ section.settings.author_color }};
    margin-bottom: 4px;
  }

  .testimonial-location {
    font-size: 13px;
    color: {{ section.settings.location_color }};
  }

  .verified-badge {
    padding: 4px 10px;
    background: {{ section.settings.verified_bg_color }};
    color: {{ section.settings.verified_text_color }};
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .stars {
    font-size: 18px;
    margin-bottom: 16px;
    line-height: 1;
  }

  .testimonial-text {
    font-size: 16px;
    color: {{ section.settings.testimonial_text_color }};
    line-height: 1.7;
    margin-bottom: 16px;
    font-style: italic;
  }

  .testimonial-usecase {
    font-size: 13px;
    color: {{ section.settings.usecase_color }};
    padding-top: 16px;
    border-top: 1px solid #E5DDD4;
    margin: 0;
  }

  @media (max-width: 768px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .testimonial-card {
      padding: 24px;
    }

    .section-title {
      font-size: calc({{ section.settings.title_size }}px * 0.8);
    }
  }
</style>

