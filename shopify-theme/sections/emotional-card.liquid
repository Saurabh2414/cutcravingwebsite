<section class="emotional-card-section" style="padding: 0 6% 16px; background: {{ section.settings.background_color }};">
  <div id="emotionCard-{{ section.id }}" class="emotion-card">
    <h2 class="emotion-title">{{ section.settings.title }}</h2>

    <p class="emotion-subtitle">{{ section.settings.subtitle }}</p>

    <ul class="benefits-list">
      {% for block in section.blocks %}
        <li class="benefit-item" {{ block.shopify_attributes }}>
          {{ block.settings.icon }} {{ block.settings.text }}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

<style>
  .emotional-card-section {
    padding: 0 6% 16px;
  }

  .emotion-card {
    background: linear-gradient(135deg, #ffffff 0%, {{ section.settings.card_bg_end }} 100%);
    padding: 40px 28px;
    border-radius: 24px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s ease-out;
  }

  .emotion-card.reveal {
    opacity: 1;
    transform: translateY(0);
  }

  .emotion-title {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    margin: 0 0 12px 0;
    color: {{ section.settings.title_color }};
    line-height: 1.3;
    letter-spacing: -0.5px;
  }

  .emotion-subtitle {
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 700;
    margin-bottom: 28px;
    color: {{ section.settings.subtitle_color }};
    line-height: 1.4;
  }

  .benefits-list {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
    max-width: 280px;
    margin: 0 auto;
  }

  .benefit-item {
    font-size: 16px;
    color: {{ section.settings.benefit_text_color }};
    padding: 10px 0;
    font-weight: 500;
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.6s ease-out;
  }

  .benefit-item.reveal {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .emotion-title {
      font-size: calc({{ section.settings.title_size }}px * 0.85);
    }
  }
</style>

<script>
  (function() {
    const card = document.getElementById('emotionCard-{{ section.id }}');
    const benefits = card.querySelectorAll('.benefit-item');
    let animated = false;

    function triggerAnimation() {
      if (animated) return;

      const rect = card.getBoundingClientRect();
      const windowHeight = window.innerHeight || document.documentElement.clientHeight;

      // Trigger when card is 65% visible
      if (rect.top <= windowHeight * 0.65) {
        animated = true;

        // Card fades in
        card.classList.add('reveal');

        // Benefits appear progressively
        benefits.forEach((benefit, index) => {
          setTimeout(() => {
            benefit.classList.add('reveal');
          }, 200 + (index * 400));
        });
      }
    }

    window.addEventListener('scroll', triggerAnimation);
    window.addEventListener('load', triggerAnimation);
    setTimeout(triggerAnimation, 100);
  })();
</script>

{% schema %}
{
  "name": "Emotional Card",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#f8f6f3"
    },
    {
      "type": "color",
      "id": "card_bg_end",
      "label": "Card Background Gradient End",
      "default": "#f8f6f3"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Main Title",
      "default": "You don't need willpower."
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "You need better food."
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle Size",
      "min": 16,
      "max": 32,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#3d5f4a"
    },
    {
      "type": "color",
      "id": "benefit_text_color",
      "label": "Benefit Text Color",
      "default": "#5a5a5a"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Benefit Text",
          "default": "Stays with you longer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Emotional Card",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "text": "Stays with you longer"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "text": "No sugar highs or lows"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "text": "Feels good — physically & mentally"
          }
        }
      ]
    }
  ]
}
{% endschema %}
