<section class="rotating-flagship-section">
  <div class="flagship-container">
    <div class="section-header">
      <div class="section-kicker">{{ section.settings.kicker }}</div>
      <h2 class="section-title">{{ section.settings.title }}</h2>
    </div>

    <!-- Carousel Container -->
    <div class="flagship-carousel" id="flagshipCarousel-{{ section.id }}">

      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          {% assign product = all_products[block.settings.product_handle] %}
          <div class="flagship-slide{% if forloop.first %} active{% endif %}" data-slide="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="flagship-content">
              <div class="flagship-badge">{{ block.settings.badge }}</div>
              <h3 class="flagship-product-title">{{ block.settings.product_title }}</h3>
              <p class="flagship-tagline">{{ block.settings.tagline }}</p>

              <ul class="flagship-benefits">
                {% if block.settings.benefit_1 %}<li>{{ block.settings.benefit_1 }}</li>{% endif %}
                {% if block.settings.benefit_2 %}<li>{{ block.settings.benefit_2 }}</li>{% endif %}
                {% if block.settings.benefit_3 %}<li>{{ block.settings.benefit_3 }}</li>{% endif %}
                {% if block.settings.benefit_4 %}<li>{{ block.settings.benefit_4 }}</li>{% endif %}
              </ul>

              <div class="flagship-routine">
                <strong>Best time:</strong> {{ block.settings.best_time }}
              </div>

              {% if product %}
                <div class="flagship-price">
                  <span class="price-current">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="price-original">{{ product.compare_at_price | money }}</span>
                    <span class="price-badge">{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% OFF</span>
                  {% endif %}
                </div>
              {% else %}
                <div class="flagship-price">
                  <span class="price-current">{{ block.settings.price }}</span>
                  <span class="price-original">{{ block.settings.compare_price }}</span>
                  <span class="price-badge">{{ block.settings.discount_badge }}</span>
                </div>
              {% endif %}

              <div class="flagship-ctas">
                <a href="{{ block.settings.primary_link }}" class="btn-primary">{{ block.settings.primary_cta }}</a>
                <a href="{{ block.settings.secondary_link }}" class="btn-secondary-outline">{{ block.settings.secondary_cta }}</a>
              </div>
            </div>

            <div class="flagship-visual">
              <div class="flagship-product-image {{ block.settings.glow_class }}">
                {% if block.settings.product_image %}
                  <img src="{{ block.settings.product_image | img_url: '600x600' }}" alt="{{ block.settings.product_title | escape }}" loading="lazy" class="uploaded-product-image">
                {% elsif block.settings.visual_type == 'jar' %}
                  <div class="product-jar-large">
                    <div class="jar-lid-large"></div>
                    <div class="jar-label-large">
                      <span class="jar-brand">{{ block.settings.jar_brand }}</span>
                      <span class="jar-product">{{ block.settings.jar_label }}</span>
                    </div>
                  </div>
                {% elsif block.settings.visual_type == 'tea' %}
                  <div class="tea-package-large {{ block.settings.tea_class }}">
                    <span class="package-label">{{ block.settings.tea_icon }}<br>{{ block.settings.tea_name }}<br>Tea</span>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}

      <!-- Carousel Controls -->
      <div class="carousel-controls">
        <button class="carousel-arrow carousel-prev" aria-label="Previous product" onclick="changeSlide(-1, '{{ section.id }}')">
          ←
        </button>
        <div class="carousel-dots">
          {% for block in section.blocks %}
            {% if block.type == 'slide' %}
              <button class="carousel-dot{% if forloop.first %} active{% endif %}" data-slide="{{ forloop.index }}" aria-label="Slide {{ forloop.index }}" onclick="goToSlide({{ forloop.index }}, '{{ section.id }}')"></button>
            {% endif %}
          {% endfor %}
        </div>
        <button class="carousel-arrow carousel-next" aria-label="Next product" onclick="changeSlide(1, '{{ section.id }}')">
          →
        </button>
      </div>

      <!-- Slide Counter -->
      <div class="carousel-counter">
        <span class="current-slide">1</span> / {{ section.blocks.size }}
      </div>
    </div>
  </div>
</section>

<style>
  .rotating-flagship-section {
    padding: 80px 5%;
    background: #FFF9F3;  /* Cream-light background like original */
  }

  .flagship-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-kicker {
    font-size: 12px;
    letter-spacing: 2px;
    color: {{ section.settings.kicker_color }};
    font-weight: 700;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    margin: 0;
    letter-spacing: -0.5px;
  }

  .flagship-carousel {
    position: relative;
    min-height: 500px;
  }

  .flagship-slide {
    display: none;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    background: white;
    padding: 60px 50px;
    border-radius: 20px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    opacity: 0;
    transform: translateX(30px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .flagship-slide.active {
    display: grid;
    opacity: 1;
    transform: translateX(0);
  }

  .flagship-content {
    /* Padding removed - now on .flagship-slide */
  }

  .flagship-badge {
    display: inline-block;
    padding: 8px 18px;
    background: #F5EDE4;
    color: #2C2416;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .flagship-product-title {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    font-weight: 700;
    color: #2C2416;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .flagship-tagline {
    font-size: 17px;
    color: #6B5D4F;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .flagship-benefits {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
  }

  .flagship-benefits li {
    font-size: 15px;
    color: #2C2416;
    line-height: 2;
    padding-left: 0;
  }

  .flagship-routine {
    font-size: 14px;
    color: #6B5D4F;
    margin-bottom: 24px;
    padding: 12px;
    background: #F5EDE4;
    border-radius: 8px;
  }

  .flagship-routine strong {
    color: #2C2416;
  }

  .flagship-price {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .price-current {
    font-size: 32px;
    font-weight: 700;
    color: #2C2416;
  }

  .price-original {
    font-size: 20px;
    color: #999;
    text-decoration: line-through;
  }

  .price-badge {
    padding: 4px 10px;
    background: #E74C3C;
    color: white;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
  }

  .flagship-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    padding: 16px 32px;
    background: #2D5F3F;  /* Solid green like original, not gradient */
    color: white;
    border-radius: 6px;  /* 6px rounded rectangle like original, not 60px pill */
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    box-shadow: 0 8px 20px rgba(61,95,74,0.3);
    transition: transform 0.3s;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(61,95,74,0.4);
  }

  .btn-secondary-outline {
    display: inline-block;
    padding: 16px 32px;
    background: transparent;
    color: #3D5F4A;
    border: 2px solid #3D5F4A;
    border-radius: 6px;  /* 6px rounded rectangle like original, not 60px pill */
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    transition: all 0.3s;
  }

  .btn-secondary-outline:hover {
    background: #3D5F4A;
    color: white;
  }

  .flagship-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .flagship-product-image {
    position: relative;
    transition: transform 0.3s;
  }

  .flagship-product-image:hover {
    transform: scale(1.05);
  }

  .uploaded-product-image {
    width: 100%;
    max-width: 400px;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
  }

  /* Product visuals */
  .product-jar-large {
    width: 200px;
    height: 280px;
    background: linear-gradient(180deg, #8B6F47 0%, #A68A5E 100%);
    border-radius: 15px;
    position: relative;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
  }

  .jar-lid-large {
    width: 100%;
    height: 30px;
    background: linear-gradient(180deg, #6B5838 0%, #8B6F47 100%);
    border-radius: 15px 15px 0 0;
  }

  .jar-label-large {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: white;
  }

  .jar-brand {
    display: block;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .jar-product {
    display: block;
    font-size: 14px;
  }

  .tea-package-large {
    width: 180px;
    height: 240px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
  }

  .hibiscus-package {
    background: linear-gradient(135deg, #E86B8A 0%, #C94D6F 100%);
  }

  .blue-tea-package {
    background: linear-gradient(135deg, #4A7B9D 0%, #2E5C7A 100%);
  }

  .chamomile-package {
    background: linear-gradient(135deg, #7FB069 0%, #5D8C4D 100%);
  }

  .package-label {
    color: white;
    font-size: 24px;
    font-weight: 700;
    text-align: center;
    line-height: 1.5;
  }

  /* Glow effects */
  .morning-glow {
    filter: drop-shadow(0 0 30px rgba(255,179,71,0.4));
  }

  .afternoon-glow {
    filter: drop-shadow(0 0 30px rgba(232,107,138,0.4));
  }

  .focus-glow {
    filter: drop-shadow(0 0 30px rgba(74,123,157,0.4));
  }

  .evening-glow {
    filter: drop-shadow(0 0 30px rgba(127,176,105,0.4));
  }

  /* Carousel controls */
  .carousel-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 40px;
  }

  .carousel-arrow {
    background: white;
    border: 2px solid #3D5F4A;
    color: #3D5F4A;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 20px;
    cursor: pointer;
    transition: all 0.3s;
  }

  .carousel-arrow:hover {
    background: #3D5F4A;
    color: white;
  }

  .carousel-dots {
    display: flex;
    gap: 12px;
  }

  .carousel-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #D5C7B8;
    border: none;
    cursor: pointer;
    transition: all 0.3s;
  }

  .carousel-dot.active {
    background: #3D5F4A;
    width: 32px;
    border-radius: 6px;
  }

  .carousel-counter {
    text-align: center;
    margin-top: 20px;
    font-size: 16px;
    color: #6B5D4F;
  }

  .current-slide {
    font-weight: 700;
    color: #2C2416;
  }

  @media (max-width: 1024px) {
    .flagship-slide {
      grid-template-columns: 1fr;
      padding: 40px 30px;
    }

    .flagship-product-title {
      font-size: 32px;
    }

    .flagship-product-image {
      width: 300px;
      height: 300px;
    }

    .product-jar-large {
      width: 220px;
      height: 260px;
    }

    .tea-package-large {
      width: 200px;
      height: 240px;
    }
  }

  @media (max-width: 768px) {
    .flagship-slide {
      padding: 30px 24px;
    }

    .flagship-product-title {
      font-size: 26px;
    }

    .flagship-tagline {
      font-size: 15px;
    }

    .flagship-ctas {
      flex-direction: column;
    }

    .flagship-ctas .btn-primary,
    .flagship-ctas .btn-secondary-outline {
      width: 100%;
      text-align: center;
    }

    .flagship-product-image {
      width: 250px;
      height: 250px;
    }
  }
</style>

<script>
  (function() {
    let currentSlide = 1;
    let autoRotateInterval;
    const sectionId = '{{ section.id }}';

    window.changeSlide = function(direction, id) {
      if (id !== sectionId) return;

      const carousel = document.getElementById('flagshipCarousel-' + sectionId);
      const slides = carousel.querySelectorAll('.flagship-slide');
      const dots = carousel.querySelectorAll('.carousel-dot');
      const counter = carousel.querySelector('.current-slide');

      slides[currentSlide - 1].classList.remove('active');
      dots[currentSlide - 1].classList.remove('active');

      currentSlide += direction;

      if (currentSlide > slides.length) currentSlide = 1;
      if (currentSlide < 1) currentSlide = slides.length;

      slides[currentSlide - 1].classList.add('active');
      dots[currentSlide - 1].classList.add('active');
      counter.textContent = currentSlide;

      resetAutoRotate();
    };

    window.goToSlide = function(slideNum, id) {
      if (id !== sectionId) return;

      const carousel = document.getElementById('flagshipCarousel-' + sectionId);
      const slides = carousel.querySelectorAll('.flagship-slide');
      const dots = carousel.querySelectorAll('.carousel-dot');
      const counter = carousel.querySelector('.current-slide');

      slides[currentSlide - 1].classList.remove('active');
      dots[currentSlide - 1].classList.remove('active');

      currentSlide = slideNum;

      slides[currentSlide - 1].classList.add('active');
      dots[currentSlide - 1].classList.add('active');
      counter.textContent = currentSlide;

      resetAutoRotate();
    };

    function resetAutoRotate() {
      clearInterval(autoRotateInterval);
      {% if section.settings.auto_rotate %}
      autoRotateInterval = setInterval(function() {
        changeSlide(1, sectionId);
      }, {{ section.settings.rotation_speed | times: 1000 }});
      {% endif %}
    }

    // Start auto-rotation
    resetAutoRotate();
  })();
</script>

