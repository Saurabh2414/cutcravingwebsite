<footer class="footer" style="background: {{ section.settings.footer_bg }}; color: {{ section.settings.footer_text_color }};">
  <div class="footer-content">
    <!-- Footer Brand -->
    <div class="footer-brand">
      <h3>{{ section.settings.brand_name }}</h3>
      <p>{{ section.settings.brand_description }}</p>

      <!-- Trust Seals -->
      <div class="footer-trust-seals">
        {% for block in section.blocks %}
          {% if block.type == 'trust_seal' %}
            <div class="trust-seal" {{ block.shopify_attributes }}>{{ block.settings.icon }} {{ block.settings.text }}</div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Social -->
      {% if section.settings.social_text %}
        <div class="footer-social">
          {{ section.settings.social_text }} <a href="{{ section.settings.social_link }}" target="_blank" rel="noopener">{{ section.settings.social_handle }}</a> {{ section.settings.social_suffix }}
        </div>
      {% endif %}
    </div>

    <!-- Footer Sections -->
    {% for block in section.blocks %}
      {% if block.type == 'footer_section' %}
        <div class="footer-section" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {% if block.settings.link_1_text %}
              <li><a href="{{ block.settings.link_1_url }}">{{ block.settings.link_1_text }}</a></li>
            {% endif %}
            {% if block.settings.link_2_text %}
              <li><a href="{{ block.settings.link_2_url }}">{{ block.settings.link_2_text }}</a></li>
            {% endif %}
            {% if block.settings.link_3_text %}
              <li><a href="{{ block.settings.link_3_url }}">{{ block.settings.link_3_text }}</a></li>
            {% endif %}
            {% if block.settings.link_4_text %}
              <li><a href="{{ block.settings.link_4_url }}">{{ block.settings.link_4_text }}</a></li>
            {% endif %}
            {% if block.settings.link_5_text %}
              <li>{{ block.settings.link_5_text }}</li>
            {% endif %}
          </ul>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if section.settings.trust_line %}
    <div class="footer-trust-line">
      {{ section.settings.trust_line }}
    </div>
  {% endif %}

  <div class="footer-bottom">
    <p>{{ section.settings.copyright_text }}</p>
  </div>
</footer>

<style>
  .footer {
    padding: {{ section.settings.footer_padding }}px 5% 40px;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
    padding-bottom: 40px;
  }

  .footer-brand h3 {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.brand_name_size }}px;
    font-weight: 800;
    color: {{ section.settings.brand_name_color }};
    margin: 0 0 16px 0;
    letter-spacing: -0.5px;
  }

  .footer-brand p {
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 28px;
    color: {{ section.settings.brand_desc_color }};
  }

  .footer-trust-seals {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .trust-seal {
    padding: 8px 14px;
    background: {{ section.settings.trust_seal_bg }};
    color: {{ section.settings.trust_seal_text }};
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid {{ section.settings.trust_seal_border }};
  }

  .footer-social {
    font-size: 14px;
    color: {{ section.settings.social_text_color }};
  }

  .footer-social a {
    color: {{ section.settings.social_link_color }};
    text-decoration: none;
    font-weight: 700;
    transition: color 0.3s;
  }

  .footer-social a:hover {
    color: {{ section.settings.social_link_hover }};
    text-decoration: underline;
  }

  .footer-section h4 {
    font-size: {{ section.settings.section_heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.section_heading_color }};
    margin: 0 0 20px 0;
  }

  .footer-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-section li {
    margin-bottom: 12px;
  }

  .footer-section a {
    color: {{ section.settings.link_color }};
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s;
  }

  .footer-section a:hover {
    color: {{ section.settings.link_hover_color }};
  }

  .footer-trust-line {
    text-align: center;
    padding: 20px 0;
    border-top: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.trust_line_color }};
    letter-spacing: 0.5px;
  }

  .footer-bottom {
    text-align: center;
    padding-top: 28px;
    font-size: 13px;
    color: {{ section.settings.copyright_color }};
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 992px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 576px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-brand h3 {
      font-size: calc({{ section.settings.brand_name_size }}px * 0.85);
    }

    .trust-seal {
      font-size: 12px;
      padding: 6px 12px;
    }
  }
</style>

