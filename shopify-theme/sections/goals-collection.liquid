<section class="goals-section" style="padding: 24px 6% 16px; background: {{ section.settings.background_color }};">
  <h3 class="goals-title">{{ section.settings.title }}</h3>

  {% for block in section.blocks %}
    <a href="{{ block.settings.link }}" class="goal-card" {{ block.shopify_attributes }}>
      <span class="goal-icon">{{ block.settings.icon }}</span>
      <span class="goal-text">{{ block.settings.text }}</span>
      <span class="goal-arrow">→</span>
    </a>
  {% endfor %}
</section>

<style>
  .goals-section {
    padding: 24px 6% 16px;
  }

  .goals-title {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    text-align: center;
    margin: 0 0 28px 0;
    color: {{ section.settings.title_color }};
    letter-spacing: -0.5px;
  }

  .goal-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: linear-gradient(135deg, #ffffff 0%, #fafaf8 100%);
    padding: 20px 18px;
    border-radius: 20px;
    margin-bottom: 12px;
    text-decoration: none;
    box-shadow: 0 3px 12px rgba(0,0,0,0.06);
    transition: all 0.3s;
  }

  .goal-card:hover {
    transform: translateX(4px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.1);
  }

  .goal-icon {
    width: 52px;
    height: 52px;
    background: {{ section.settings.icon_bg_color }};
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
  }

  .goal-text {
    flex: 1;
    font-size: 17px;
    font-weight: 700;
    color: {{ section.settings.text_color }};
  }

  .goal-arrow {
    font-size: 22px;
    color: {{ section.settings.arrow_color }};
  }
</style>

{% schema %}
{
  "name": "Goals / Collection Links",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "What moment needs solving?"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f6f3"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon Background Color",
      "default": "#f8f6f3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow Color",
      "default": "#3d5f4a"
    }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Goal Link",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🏋️"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Goal Text",
          "default": "Feel Full Without Snacking"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Goals Section",
      "blocks": [
        {
          "type": "goal",
          "settings": {
            "icon": "🏋️",
            "text": "Feel Full Without Snacking"
          }
        },
        {
          "type": "goal",
          "settings": {
            "icon": "🌙",
            "text": "Sleep Deeper, Naturally"
          }
        },
        {
          "type": "goal",
          "settings": {
            "icon": "⚡",
            "text": "Stay Sharp Without Jitters"
          }
        }
      ]
    }
  ]
}
{% endschema %}
