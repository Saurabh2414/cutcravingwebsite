<nav class="navbar">
  <a href="/" class="logo">{{ section.settings.logo_text }}</a>

  <ul class="nav-links">
    {% for block in section.blocks %}
      {% if block.type == 'nav_link' %}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link }}">{{ block.settings.label }}</a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>

  <a href="/cart" class="cart-button">
    {{ section.settings.cart_icon }} {{ section.settings.cart_text }}
    {% if cart.item_count > 0 %}
      <span class="cart-badge">{{ cart.item_count }}</span>
    {% endif %}
  </a>
</nav>

<style>
  .navbar {
    background: rgba(255, 249, 243, 0.95);
    padding: 20px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(139, 111, 71, 0.15);
    position: sticky;
    top: 40px;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .logo {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.logo_size }}px;
    font-weight: 700;
    color: {{ section.settings.logo_color }};
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 35px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    text-decoration: none;
    color: {{ section.settings.nav_text_color }};
    font-weight: 500;
    font-size: 14px;
    transition: color 0.3s;
  }

  .nav-links a:hover {
    color: {{ section.settings.nav_hover_color }};
  }

  .cart-button {
    background: {{ section.settings.cart_bg_color }};
    color: {{ section.settings.cart_text_color }};
    border: none;
    padding: 10px 24px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 2px 8px rgba(45, 95, 63, 0.15);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .cart-button:hover {
    background: {{ section.settings.cart_hover_color }};
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 4px 12px rgba(45, 95, 63, 0.25);
  }

  @keyframes cartPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  .cart-badge {
    animation: cartPulse 2s ease-in-out infinite;
    background: rgba(255, 255, 255, 0.3);
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "CutCraving"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo Size",
      "min": 16,
      "max": 48,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo Color",
      "default": "#2D5F3F"
    },
    {
      "type": "color",
      "id": "nav_text_color",
      "label": "Navigation Text Color",
      "default": "#2C2416"
    },
    {
      "type": "color",
      "id": "nav_hover_color",
      "label": "Navigation Hover Color",
      "default": "#2D5F3F"
    },
    {
      "type": "text",
      "id": "cart_icon",
      "label": "Cart Icon",
      "default": "🛒"
    },
    {
      "type": "text",
      "id": "cart_text",
      "label": "Cart Button Text",
      "default": "Cart"
    },
    {
      "type": "color",
      "id": "cart_bg_color",
      "label": "Cart Button Background",
      "default": "#2D5F3F"
    },
    {
      "type": "color",
      "id": "cart_text_color",
      "label": "Cart Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cart_hover_color",
      "label": "Cart Button Hover Color",
      "default": "#234a31"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Products"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "nav_link",
          "settings": {
            "label": "Products",
            "link": "/collections/all"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "label": "About",
            "link": "/pages/about"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "label": "Reviews",
            "link": "/pages/reviews"
          }
        }
      ]
    }
  ]
}
{% endschema %}
