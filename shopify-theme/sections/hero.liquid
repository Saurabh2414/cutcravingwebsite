      "label": "Primary Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "primary_button_hover",
      "label": "Primary Button Hover Color",
      "default": "#234a31"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "color",
      "id": "secondary_button_color",
      "label": "Secondary Button Color",
      "default": "#2C2416"
    },
    {
      "type": "header",
      "content": "Product Jar"
    },
    {
      "type": "text",
      "id": "jar_brand",
      "label": "Jar Brand Text",
      "default": "CutCraving"
    },
    {
      "type": "text",
      "id": "jar_percentage",
      "label": "Jar Percentage",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "jar_product_name",
      "label": "Jar Product Name",
      "default": "PEANUT BUTTER"
    },
    {
      "type": "text",
      "id": "jar_detail",
      "label": "Jar Detail Text",
      "default": "No Sugar • No Oil"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Made Fresh Weekly"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "icon": "✓",
            "text": "Made Fresh Weekly"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
