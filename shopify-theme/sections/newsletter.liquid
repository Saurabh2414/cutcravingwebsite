<section class="newsletter-section" style="padding: 40px 6%; background: {{ section.settings.background_color }};">
  <h3 class="newsletter-title">{{ section.settings.title }}</h3>
  <p class="newsletter-subtitle">{{ section.settings.subtitle }}</p>

  {% form 'customer', class: 'newsletter-form' %}
    {{ form.errors | default_errors }}

    {% if form.posted_successfully? %}
      <p class="success-message">{{ section.settings.success_message }}</p>
    {% else %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <input
        type="email"
        name="contact[email]"
        placeholder="{{ section.settings.placeholder }}"
        required
        class="newsletter-input"
      >

      <button type="submit" class="newsletter-button">
        {{ section.settings.button_text }} →
      </button>
    {% endif %}
  {% endform %}
</section>

<style>
  .newsletter-section {
    padding: 40px 6%;
  }

  .newsletter-title {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    text-align: center;
    margin: 0 0 12px 0;
    color: {{ section.settings.title_color }};
    letter-spacing: -0.5px;
  }

  .newsletter-subtitle {
    text-align: center;
    font-size: 14px;
    color: {{ section.settings.subtitle_color }};
    margin-bottom: 28px;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 400px;
    margin: 0 auto;
  }

  .newsletter-input {
    padding: 16px 20px;
    border: 2px solid {{ section.settings.input_border_color }};
    border-radius: 50px;
    font-size: 16px;
    background: {{ section.settings.input_bg_color }};
    transition: border-color 0.3s;
  }

  .newsletter-input:focus {
    outline: none;
    border-color: {{ section.settings.input_focus_color }};
  }

  .newsletter-button {
    padding: 16px;
    background: linear-gradient(135deg, {{ section.settings.button_bg_start }} 0%, {{ section.settings.button_bg_end }} 100%);
    color: {{ section.settings.button_text_color }};
    border: none;
    border-radius: 50px;
    font-size: 16px;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(61,95,74,0.3);
    cursor: pointer;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .newsletter-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(61,95,74,0.4);
  }

  .success-message {
    text-align: center;
    color: {{ section.settings.success_color }};
    font-size: 16px;
    font-weight: 600;
    padding: 20px;
    background: rgba(45, 95, 63, 0.1);
    border-radius: 12px;
  }

  .errors {
    text-align: center;
    color: #d32f2f;
    font-size: 14px;
    margin-bottom: 10px;
  }
</style>

{% schema %}
{
  "name": "Newsletter Signup",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Build better food habits."
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Simple routines. No spam."
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#5a5a5a"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f6f3"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Placeholder Text",
      "default": "Your email"
    },
    {
      "type": "color",
      "id": "input_bg_color",
      "label": "Input Background Color",
      "default": "#fafaf8"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input Border Color",
      "default": "rgba(61,95,74,0.15)"
    },
    {
      "type": "color",
      "id": "input_focus_color",
      "label": "Input Focus Color",
      "default": "#3d5f4a"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Join"
    },
    {
      "type": "color",
      "id": "button_bg_start",
      "label": "Button Background Start",
      "default": "#3d5f4a"
    },
    {
      "type": "color",
      "id": "button_bg_end",
      "label": "Button Background End",
      "default": "#2d4a38"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "Success Message Color",
      "default": "#3d5f4a"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Signup"
    }
  ]
}
{% endschema %}
