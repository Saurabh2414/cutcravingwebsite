{% render 'pdp-animations' %}

<section class="craving-explanation">
  <div class="craving-container">
    <!-- Split dramatic headline -->
    <div class="headline-split">
      <h2 class="craving-title-part1">{{ section.settings.title_part1 | default: "This isn't hunger." }}</h2>
      <h2 class="craving-title-part2">{{ section.settings.title_part2 | default: "This is a blood sugar crash." }}</h2>
    </div>

    <p class="craving-subtext">{{ section.settings.subtext | default: "Between 3-5 PM, your blood sugar dips. Your brain asks for something sweet and rich. Most snacks spike you again. We designed this not to." }}</p>

    <!-- THE TRAP: Animated cycle visualization -->
    <div class="trap-cycle">

      <!-- Step 1: SPIKE -->
      <div class="cycle-step" data-step="1">
        <div class="cycle-badge spike-badge">
          <svg class="icon-graph-up" viewBox="0 0 60 60" width="60" height="60">
            <polyline class="graph-line" points="5,50 15,35 25,40 35,20 45,25 55,10"
                      fill="none" stroke="#FF6B6B" stroke-width="4" stroke-linecap="round"/>
            <circle class="graph-dot" cx="55" cy="10" r="4" fill="#FF6B6B"/>
          </svg>
        </div>
        <span class="cycle-label">SPIKE</span>
      </div>

      <!-- Connecting Arrow 1 -->
      <div class="cycle-arrow" data-arrow="1">
        <svg width="60" height="24" viewBox="0 0 60 24">
          <defs>
            <marker id="arrowhead1" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
              <polygon points="0 0, 10 3, 0 6" fill="#8B7355" />
            </marker>
          </defs>
          <line class="arrow-line" x1="0" y1="12" x2="60" y2="12"
                stroke="#8B7355" stroke-width="3" marker-end="url(#arrowhead1)"/>
        </svg>
      </div>

      <!-- Step 2: CRASH -->
      <div class="cycle-step" data-step="2">
        <div class="cycle-badge crash-badge">
          <svg class="icon-graph-down" viewBox="0 0 60 60" width="60" height="60">
            <polyline class="graph-line" points="5,10 15,15 25,20 35,35 45,45 55,50"
                      fill="none" stroke="#E74C3C" stroke-width="4" stroke-linecap="round"/>
            <circle class="graph-dot" cx="55" cy="50" r="4" fill="#E74C3C"/>
          </svg>
        </div>
        <span class="cycle-label">CRASH</span>
      </div>

      <!-- Connecting Arrow 2 -->
      <div class="cycle-arrow" data-arrow="2">
        <svg width="60" height="24" viewBox="0 0 60 24">
          <line class="arrow-line" x1="0" y1="12" x2="60" y2="12"
                stroke="#8B7355" stroke-width="3" marker-end="url(#arrowhead1)"/>
        </svg>
      </div>

      <!-- Step 3: CRAVE -->
      <div class="cycle-step" data-step="3">
        <div class="cycle-badge crave-badge">
          <div class="chocolate-bar">🍫</div>
        </div>
        <span class="cycle-label">CRAVE</span>
      </div>

      <!-- Connecting Arrow 3 -->
      <div class="cycle-arrow" data-arrow="3">
        <svg width="60" height="24" viewBox="0 0 60 24">
          <line class="arrow-line" x1="0" y1="12" x2="60" y2="12"
                stroke="#8B7355" stroke-width="3" marker-end="url(#arrowhead1)"/>
        </svg>
      </div>

      <!-- Step 4: REPEAT -->
      <div class="cycle-step" data-step="4">
        <div class="cycle-badge repeat-badge">
          <svg class="icon-cycle" viewBox="0 0 60 60" width="60" height="60">
            <path class="cycle-arrow-path"
                  d="M 45 15 A 15 15 0 1 1 15 15"
                  fill="none" stroke="#3498DB" stroke-width="4" stroke-linecap="round"/>
            <polygon points="15,15 10,8 20,8" fill="#3498DB"/>
            <path class="cycle-arrow-path"
                  d="M 15 45 A 15 15 0 1 1 45 45"
                  fill="none" stroke="#3498DB" stroke-width="4" stroke-linecap="round"/>
            <polygon points="45,45 50,52 40,52" fill="#3498DB"/>
          </svg>
        </div>
        <span class="cycle-label">REPEAT</span>
      </div>

    </div>

    <!-- Warning pulse after cycle completes -->
    <div class="trap-warning">
      <p>{{ section.settings.warning | default: "This cycle keeps you trapped. Until you break it." }}</p>
    </div>

  </div>
</section>

<style>
  .craving-explanation {
    padding: 120px 5%;
    background: linear-gradient(135deg, #FFF9F3 0%, #F5EDE0 50%, #FFF9F3 100%);
    position: relative;
    overflow: hidden;
  }

  /* Subtle background pattern */
  .craving-explanation::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: radial-gradient(circle at 20% 30%, rgba(255, 107, 107, 0.03) 0%, transparent 50%),
                      radial-gradient(circle at 80% 70%, rgba(231, 76, 60, 0.03) 0%, transparent 50%);
    pointer-events: none;
  }

  .craving-container {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  /* DRAMATIC SPLIT HEADLINE */
  .headline-split {
    margin-bottom: 32px;
  }

  .craving-title-part1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 600;
    color: #5A4D3F;
    line-height: 1.2;
    margin: 0 0 8px 0;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translateY(-20px);
    animation: headlineDrop 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
  }

  .craving-title-part2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 800;
    color: #2C2416;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translateY(-20px);
    animation: headlineDrop 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards;
    position: relative;
  }

  /* Underline emphasis on "blood sugar crash" */
  .craving-title-part2::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 90%;
    height: 4px;
    background: linear-gradient(90deg, #FF6B6B, #E74C3C);
    border-radius: 2px;
    animation: underlineDraw 0.6s cubic-bezier(0.22, 1, 0.36, 1) 1.3s forwards;
  }

  @keyframes headlineDrop {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes underlineDraw {
    to {
      transform: translateX(-50%) scaleX(1);
    }
  }

  .craving-subtext {
    font-size: clamp(16px, 2vw, 19px);
    color: #5A4D3F;
    line-height: 1.7;
    margin-bottom: 80px;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
    transform: translateY(20px);
    animation: subtextFade 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.9s forwards;
  }

  @keyframes subtextFade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* THE TRAP CYCLE - Premium Visual Storytelling */
  .trap-cycle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin: 80px 0 60px 0;
    flex-wrap: wrap;
  }

  /* Cycle Step Container */
  .cycle-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    opacity: 0;
    transform: scale(0.8) translateY(20px);
  }

  /* Staggered reveal animation */
  .cycle-step[data-step="1"] {
    animation: stepReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) 1.8s forwards;
  }

  .cycle-step[data-step="2"] {
    animation: stepReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) 2.4s forwards;
  }

  .cycle-step[data-step="3"] {
    animation: stepReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) 3.0s forwards;
  }

  .cycle-step[data-step="4"] {
    animation: stepReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) 3.6s forwards;
  }

  @keyframes stepReveal {
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Circular Icon Badges - PREMIUM */
  .cycle-badge {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.08),
      0 8px 32px rgba(0, 0, 0, 0.06);
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
  }

  .cycle-badge:hover {
    transform: scale(1.1) rotate(5deg);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.12),
      0 16px 48px rgba(0, 0, 0, 0.08);
  }

  /* Individual badge colors */
  .spike-badge {
    background: linear-gradient(135deg, #FFE5E5 0%, #FFD0D0 100%);
  }

  .crash-badge {
    background: linear-gradient(135deg, #FFD5D5 0%, #FFC0C0 100%);
  }

  .crave-badge {
    background: linear-gradient(135deg, #F5E6D3 0%, #E8D4BB 100%);
  }

  .repeat-badge {
    background: linear-gradient(135deg, #D5E5FF 0%, #C0D8FF 100%);
  }

  /* Graph animations */
  .icon-graph-up .graph-line,
  .icon-graph-down .graph-line {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  .cycle-step[data-step="1"] .graph-line {
    animation: drawLine 1.2s cubic-bezier(0.22, 1, 0.36, 1) 2.0s forwards;
  }

  .cycle-step[data-step="2"] .graph-line {
    animation: drawLine 1.2s cubic-bezier(0.22, 1, 0.36, 1) 2.6s forwards;
  }

  @keyframes drawLine {
    to {
      stroke-dashoffset: 0;
    }
  }

  .icon-graph-up .graph-dot,
  .icon-graph-down .graph-dot {
    opacity: 0;
    transform: scale(0);
  }

  .cycle-step[data-step="1"] .graph-dot {
    animation: dotPop 0.4s cubic-bezier(0.22, 1, 0.36, 1) 3.0s forwards;
  }

  .cycle-step[data-step="2"] .graph-dot {
    animation: dotPop 0.4s cubic-bezier(0.22, 1, 0.36, 1) 3.6s forwards;
  }

  @keyframes dotPop {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Chocolate shake animation */
  .chocolate-bar {
    font-size: 56px;
    animation: chocolateShake 0.5s ease-in-out 3.2s 3;
  }

  @keyframes chocolateShake {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-8deg); }
    75% { transform: rotate(8deg); }
  }

  /* Cycle spin animation */
  .icon-cycle {
    animation: cycleSpin 2s linear 3.8s infinite;
  }

  @keyframes cycleSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Cycle Labels */
  .cycle-label {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;
    color: #2C2416;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  /* Connecting Arrows - Draw in animation */
  .cycle-arrow {
    opacity: 0;
  }

  .cycle-arrow[data-arrow="1"] {
    animation: arrowFade 0.4s cubic-bezier(0.22, 1, 0.36, 1) 2.2s forwards;
  }

  .cycle-arrow[data-arrow="2"] {
    animation: arrowFade 0.4s cubic-bezier(0.22, 1, 0.36, 1) 2.8s forwards;
  }

  .cycle-arrow[data-arrow="3"] {
    animation: arrowFade 0.4s cubic-bezier(0.22, 1, 0.36, 1) 3.4s forwards;
  }

  @keyframes arrowFade {
    to { opacity: 1; }
  }

  .arrow-line {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
  }

  .cycle-arrow[data-arrow="1"] .arrow-line {
    animation: drawArrow 0.6s cubic-bezier(0.22, 1, 0.36, 1) 2.2s forwards;
  }

  .cycle-arrow[data-arrow="2"] .arrow-line {
    animation: drawArrow 0.6s cubic-bezier(0.22, 1, 0.36, 1) 2.8s forwards;
  }

  .cycle-arrow[data-arrow="3"] .arrow-line {
    animation: drawArrow 0.6s cubic-bezier(0.22, 1, 0.36, 1) 3.4s forwards;
  }

  @keyframes drawArrow {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Warning message - appears after cycle */
  .trap-warning {
    opacity: 0;
    transform: translateY(20px);
    animation: warningReveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) 4.2s forwards;
  }

  .trap-warning p {
    font-size: 20px;
    font-weight: 600;
    color: #2C2416;
    margin: 0;
    padding: 24px 40px;
    background: linear-gradient(135deg, rgba(255, 107, 107, 0.08), rgba(231, 76, 60, 0.08));
    border-radius: 16px;
    border-left: 4px solid #E74C3C;
    display: inline-block;
  }

  @keyframes warningReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Infinite loop animation - subtle pulsing after initial reveal */
  @keyframes trapPulse {
    0%, 100% {
      box-shadow:
        0 4px 16px rgba(0, 0, 0, 0.08),
        0 8px 32px rgba(0, 0, 0, 0.06);
    }
    50% {
      box-shadow:
        0 4px 16px rgba(231, 76, 60, 0.2),
        0 8px 32px rgba(231, 76, 60, 0.15);
    }
  }

  .cycle-step[data-step="1"] .cycle-badge {
    animation: stepReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) 1.8s forwards,
               trapPulse 4s ease-in-out 5s infinite;
  }

  .cycle-step[data-step="2"] .cycle-badge {
    animation: stepReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) 2.4s forwards,
               trapPulse 4s ease-in-out 6s infinite;
  }

  .cycle-step[data-step="3"] .cycle-badge {
    animation: stepReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) 3.0s forwards,
               trapPulse 4s ease-in-out 7s infinite;
  }

  .cycle-step[data-step="4"] .cycle-badge {
    animation: stepReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) 3.6s forwards,
               trapPulse 4s ease-in-out 8s infinite;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .craving-explanation {
      padding: 80px 5%;
    }

    .headline-split {
      margin-bottom: 24px;
    }

    .craving-title-part1,
    .craving-title-part2 {
      font-size: clamp(26px, 7vw, 36px);
    }

    .craving-subtext {
      font-size: 16px;
      margin-bottom: 60px;
      line-height: 1.65;
    }

    .trap-cycle {
      gap: 16px;
      margin: 60px 0 40px 0;
    }

    .cycle-badge {
      width: 90px;
      height: 90px;
    }

    .icon-graph-up,
    .icon-graph-down,
    .icon-cycle {
      width: 45px;
      height: 45px;
    }

    .chocolate-bar {
      font-size: 42px;
    }

    .cycle-label {
      font-size: 14px;
      letter-spacing: 1px;
    }

    .cycle-arrow svg {
      width: 40px;
      height: 20px;
    }

    .trap-warning p {
      font-size: 17px;
      padding: 20px 28px;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .craving-title-part1,
    .craving-title-part2,
    .craving-subtext,
    .cycle-step,
    .cycle-arrow,
    .trap-warning {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .craving-title-part2::after {
      transform: translateX(-50%) scaleX(1);
    }

    .graph-line {
      stroke-dashoffset: 0;
    }

    .graph-dot {
      opacity: 1;
      transform: scale(1);
    }

    .arrow-line {
      stroke-dashoffset: 0;
    }

    .chocolate-bar,
    .icon-cycle {
      animation: none;
    }

    .cycle-badge {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "PDP Craving Explanation",
  "settings": [
    {
      "type": "text",
      "id": "title_part1",
      "label": "Headline Part 1 (Light)",
      "default": "This isn't hunger."
    },
    {
      "type": "text",
      "id": "title_part2",
      "label": "Headline Part 2 (Bold with underline)",
      "default": "This is a blood sugar crash."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Explanation Text",
      "default": "Between 3-5 PM, your blood sugar dips. Your brain asks for something sweet and rich. Most snacks spike you again. We designed this not to."
    },
    {
      "type": "text",
      "id": "warning",
      "label": "Warning Message",
      "default": "This cycle keeps you trapped. Until you break it."
    }
  ],
  "presets": [
    {
      "name": "PDP Craving Explanation"
    }
  ]
}
{% endschema %}
