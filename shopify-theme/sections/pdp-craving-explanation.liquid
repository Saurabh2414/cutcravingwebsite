<section class="craving-explanation">
  <div class="craving-container">
    <h2 class="craving-title">{{ section.settings.title }}</h2>

    <p class="craving-explanation">{{ section.settings.explanation }}</p>

    <div class="craving-diagram">
      <div class="diagram-step">
        <div class="diagram-icon">📈</div>
        <div class="diagram-label">Spike</div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-icon">📉</div>
        <div class="diagram-label">Crash</div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-icon">🍫</div>
        <div class="diagram-label">Crave</div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-icon">🔄</div>
        <div class="diagram-label">Repeat</div>
      </div>
    </div>

    <p class="craving-closing">{{ section.settings.closing_line }}</p>
  </div>
</section>

<style>
  .craving-explanation {
    padding: 100px 5%;
    background: #FFFFFF;
  }

  .craving-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .craving-title {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.3;
    margin: 0 0 32px 0;
    letter-spacing: -0.5px;
  }

  .craving-explanation {
    font-size: 18px;
    color: #2C2416;
    line-height: 1.8;
    margin-bottom: 50px;
  }

  .craving-diagram {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin: 60px 0;
    flex-wrap: wrap;
  }

  .diagram-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .diagram-icon {
    font-size: 48px;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.1));
  }

  .diagram-label {
    font-size: 14px;
    font-weight: 700;
    color: #6B5D4F;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .diagram-arrow {
    font-size: 24px;
    color: #D4A574;
    font-weight: 700;
  }

  .craving-closing {
    font-size: 16px;
    color: #2D5F3F;
    font-weight: 600;
    font-style: italic;
    margin-top: 40px;
  }

  @media (max-width: 768px) {
    .craving-explanation {
      padding: 60px 5%;
    }

    .craving-title {
      font-size: 28px;
    }

    .craving-explanation {
      font-size: 16px;
    }

    .diagram-icon {
      font-size: 36px;
    }

    .diagram-arrow {
      display: none;
    }

    .craving-diagram {
      gap: 30px;
    }
  }
</style>

{% schema %}
{
  "name": "PDP Craving Explanation",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Section Title",
      "default": "This isn't hunger. This is a blood sugar crash."
    },
    {
      "type": "textarea",
      "id": "explanation",
      "label": "Explanation Text",
      "default": "Between 3–5 PM, your blood sugar dips. Your brain asks for something sweet and rich. Most snacks spike you again. We designed this not to."
    },
    {
      "type": "text",
      "id": "closing_line",
      "label": "Closing Line",
      "default": "That's not a personal failure. That's bad food design."
    }
  ],
  "presets": [
    {
      "name": "PDP Craving Explanation"
    }
  ]
}
{% endschema %}
