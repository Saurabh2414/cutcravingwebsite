{% render 'pdp-animations' %}

<section class="craving-explanation">
  <div class="craving-container">
    <h2 class="craving-title animate-fade-up">{{ section.settings.title }}</h2>

    <p class="craving-subtext animate-fade-up delay-1">{{ section.settings.subtext }}</p>

    <div class="craving-flow">
      <div class="flow-word animate-stagger delay-1">SPIKE</div>
      <div class="flow-arrow animate-stagger delay-2">→</div>
      <div class="flow-word animate-stagger delay-3">CRASH</div>
      <div class="flow-arrow animate-stagger delay-4">→</div>
      <div class="flow-word animate-stagger delay-5">CRAVE</div>
      <div class="flow-arrow animate-stagger delay-6">→</div>
      <div class="flow-word animate-stagger delay-6">REPEAT</div>
    </div>
  </div>
</section>

<style>
  .craving-explanation {
    padding: 100px 5%;
    background: linear-gradient(135deg, #EDE3D5 0%, #E8DCC9 100%);
  }

  .craving-container {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .craving-title {
    font-family: 'Playfair Display', serif;
    font-size: 52px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.2;
    margin: 0 0 28px 0;
    letter-spacing: -1px;
  }

  .craving-subtext {
    font-size: 19px;
    color: #2C2416;
    line-height: 1.6;
    margin-bottom: 70px;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .craving-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    margin: 70px 0 0 0;
    flex-wrap: wrap;
  }

  .flow-word {
    font-family: 'Playfair Display', serif;
    font-size: 56px;
    font-weight: 800;
    color: #2C2416;
    letter-spacing: 2px;
    opacity: 0.9;
    text-shadow: 0 2px 12px rgba(44, 36, 22, 0.08);
  }

  .flow-arrow {
    font-size: 42px;
    color: rgba(44, 36, 22, 0.3);
    font-weight: 300;
  }

  @media (max-width: 768px) {
    .craving-explanation {
      padding: 70px 5%;
    }

    .craving-title {
      font-size: 34px;
      letter-spacing: -0.5px;
    }

    .craving-subtext {
      font-size: 17px;
      margin-bottom: 50px;
    }

    .craving-flow {
      gap: 20px;
      margin: 50px 0 0 0;
    }

    .flow-word {
      font-size: 36px;
      letter-spacing: 1px;
    }

    .flow-arrow {
      font-size: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "PDP Craving Explanation",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Section Title",
      "default": "This isn't hunger. This is a blood sugar crash."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Most snacks spike you again. We designed this to stop the loop."
    }
  ],
  "presets": [
    {
      "name": "PDP Craving Explanation"
    }
  ]
}
{% endschema %}
