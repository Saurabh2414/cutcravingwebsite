{% render 'pdp-animations' %}

<section class="cuts-doesnt-section">
  <div class="cuts-outer-container">
    <!-- INGREDIENT SABOTAGE REVEAL - Visual Interrupt -->
    <div class="ingredient-sabotage">
      <div class="sabotage-ingredients-horizontal">
        <div class="sabotage-item" data-delay="0">
          <span class="ingredient-name">{{ section.settings.sabotage_1 | default: "Sugar" }}</span>
          <div class="danger-glow"></div>
          <div class="strikethrough-bold strike-1"></div>
          <div class="strikethrough-bold strike-2"></div>
        </div>
        <div class="sabotage-item" data-delay="300">
          <span class="ingredient-name">{{ section.settings.sabotage_2 | default: "Palm Oil" }}</span>
          <div class="danger-glow"></div>
          <div class="strikethrough-bold strike-1"></div>
          <div class="strikethrough-bold strike-2"></div>
        </div>
        <div class="sabotage-item" data-delay="600">
          <span class="ingredient-name">{{ section.settings.sabotage_3 | default: "Salt" }}</span>
          <div class="danger-glow"></div>
          <div class="strikethrough-bold strike-1"></div>
          <div class="strikethrough-bold strike-2"></div>
        </div>
      </div>

      <p class="sabotage-provocation">
        {{ section.settings.sabotage_provocation | default: "These are why most peanut butters never satisfy." }}
      </p>

      <h2 class="sabotage-question">
        {{ section.settings.sabotage_question | default: "What happens when you remove them?" }}
      </h2>

      <!-- Visual Bridge Arrow - Extended -->
      <div class="visual-bridge">
        <svg class="bridge-arrow" width="4" height="120" viewBox="0 0 4 120" fill="none">
          <line x1="2" y1="0" x2="2" y2="100" stroke="#2C2416" stroke-width="3" stroke-dasharray="6 4"/>
          <path d="M2 100 L2 115 M-8 105 L2 115 L12 105" stroke="#2C2416" stroke-width="3" stroke-linecap="round" fill="none"/>
        </svg>
      </div>
    </div>

    <!-- Answer Section - Seamlessly Connected -->
    <div class="answer-section">
      <h2 class="cuts-section-title animate-fade-up delay-6">{{ section.settings.section_title }}</h2>
      <p class="cuts-section-subtitle animate-fade-up delay-7">{{ section.settings.section_subtitle }}</p>

      <div class="benefit-tiles-grid">
        {% assign benefit_tiles_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'benefit_tile' %}
            {% assign benefit_tiles_count = benefit_tiles_count | plus: 1 %}
            <div class="benefit-tile animate-stagger delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
              <div class="benefit-icon">{{ block.settings.icon }}</div>
              <h3 class="benefit-title">{{ block.settings.title }}</h3>
              <p class="benefit-description">{{ block.settings.description }}</p>
            </div>
          {% elsif block.type == 'cuts_item' %}
            {% assign benefit_tiles_count = benefit_tiles_count | plus: 1 %}
            <div class="benefit-tile animate-stagger delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
              <div class="benefit-icon">✓</div>
              <h3 class="benefit-title">Benefit</h3>
              <p class="benefit-description">{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}

        {% if benefit_tiles_count == 0 %}
          <!-- Default tiles when no blocks configured -->
          <div class="benefit-tile">
            <div class="benefit-icon">⚡</div>
            <h3 class="benefit-title">Stable energy</h3>
            <p class="benefit-description">Protein keeps you full for 3-4 hours—no sugar crash</p>
          </div>
          <div class="benefit-tile">
            <div class="benefit-icon">🎯</div>
            <h3 class="benefit-title">Real satiety</h3>
            <p class="benefit-description">Your body's fullness signals actually work—you feel satisfied, not tricked</p>
          </div>
          <div class="benefit-tile">
            <div class="benefit-icon">🔄</div>
            <h3 class="benefit-title">Cravings stop</h3>
            <p class="benefit-description">No rebound hunger 90 minutes later—the cycle breaks</p>
          </div>
          <div class="benefit-tile">
            <div class="benefit-icon">🧬</div>
            <h3 class="benefit-title">Real nutrition</h3>
            <p class="benefit-description">Your body gets what it's actually asking for, not empty calories</p>
          </div>
          <div class="benefit-tile">
            <div class="benefit-icon">🧘</div>
            <h3 class="benefit-title">Calm, not chaos</h3>
            <p class="benefit-description">No inflammatory ingredients means your gut and brain stay balanced</p>
          </div>
          <div class="benefit-tile">
            <div class="benefit-icon">💪</div>
            <h3 class="benefit-title">Protein power</h3>
            <p class="benefit-description">24g per serving—supports muscle, metabolism, and mood</p>
          </div>
        {% endif %}
      </div>
    </div> <!-- Close answer-section -->
  </div>
</section>

<style>
  .cuts-doesnt-section {
    padding: 100px 5%;
    background: #FFF9F3;
  }

  .cuts-outer-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .cuts-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.3;
    margin: 0 0 16px 0;
    text-align: center;
    letter-spacing: -0.5px;
  }

  .cuts-section-subtitle {
    font-size: 18px;
    color: #6B5D4F;
    text-align: center;
    margin-bottom: 60px;
    line-height: 1.6;
  }

  /* INGREDIENT SABOTAGE - Visual Interrupt (AGGRESSIVE) */
  .ingredient-sabotage {
    text-align: center;
    margin-bottom: 0;
    padding: 80px 5% 80px;
    background: linear-gradient(135deg, #FFE8E8 0%, #FFD4D4 100%);
    border-radius: 24px 24px 0 0;
    position: relative;
    overflow: visible;
    box-shadow: 0 12px 48px rgba(184, 56, 61, 0.15);
  }

  /* Answer Section - Seamless Connection */
  .answer-section {
    background: linear-gradient(180deg, rgba(255, 232, 232, 0.3) 0%, #FFF9F3 20%);
    padding: 60px 0 0 0;
    margin-top: -40px;
    position: relative;
  }

  /* HORIZONTAL Layout - More Impact */
  .sabotage-ingredients-horizontal {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(20px, 5vw, 80px);
    margin-bottom: 50px;
    flex-wrap: wrap;
  }

  .sabotage-item {
    position: relative;
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
  }

  /* Ingredient names - BIGGER */
  .ingredient-name {
    font-family: 'Playfair Display', serif;
    font-size: clamp(42px, 7vw, 72px);
    font-weight: 800;
    color: #2C2416;
    line-height: 1;
    letter-spacing: -2px;
    display: block;
    opacity: 0.3;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }

  /* DANGER GLOW - Red highlight appears first */
  .danger-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 110%;
    height: 120%;
    background: radial-gradient(ellipse, rgba(184, 56, 61, 0.15) 0%, transparent 70%);
    opacity: 0;
    z-index: 0;
  }

  /* DOUBLE STRIKETHROUGH - Hand-drawn aggressive crossing out */
  .strikethrough-bold {
    position: absolute;
    top: 50%;
    left: -15%;
    right: -15%;
    height: 8px;
    background: linear-gradient(90deg, transparent 0%, #B8383D 10%, #B8383D 90%, transparent 100%);
    transform: translateY(-50%) scaleX(0);
    transform-origin: left;
    box-shadow: 0 2px 8px rgba(184, 56, 61, 0.4);
    border-radius: 4px;
    z-index: 2;
  }

  /* Second strike at slight angle (aggressive double-cross) */
  .strike-2 {
    transform: translateY(-50%) rotate(-2deg) scaleX(0);
    height: 7px;
    opacity: 0.85;
  }

  .sabotage-provocation {
    font-size: 24px;
    color: #2C2416;
    font-weight: 700;
    margin: 0 0 40px 0;
    line-height: 1.4;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
    transform: translateY(15px);
  }

  .sabotage-question {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 800;
    color: #2C2416;
    line-height: 1.2;
    margin: 0 0 30px 0;
    letter-spacing: -1.5px;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
    transform: translateY(15px);
  }

  /* Visual Bridge Arrow - Extended Dashed Line */
  .visual-bridge {
    text-align: center;
    margin-top: 40px;
    opacity: 0;
    transform: translateY(-10px);
    position: relative;
    z-index: 10;
  }

  .bridge-arrow {
    display: inline-block;
  }

  /* Animated dash drawing */
  .bridge-arrow line {
    stroke-dasharray: 6 4;
    stroke-dashoffset: 100;
    animation: dashDraw 1.5s ease-out 2.3s forwards;
  }

  .bridge-arrow path {
    opacity: 0;
    animation: arrowheadAppear 0.4s ease-out 3.5s forwards, arrowBounce 2s ease-in-out 3.9s infinite;
  }

  @keyframes dashDraw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes arrowheadAppear {
    to {
      opacity: 1;
    }
  }

  @keyframes arrowBounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  /* CONSTANT ANIMATION - Auto-plays on page load */
  .sabotage-item {
    animation: sabotageReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .sabotage-item[data-delay="0"] {
    animation-delay: 0.3s;
  }

  .sabotage-item[data-delay="300"] {
    animation-delay: 0.6s;
  }

  .sabotage-item[data-delay="600"] {
    animation-delay: 0.9s;
  }

  /* DRAMATIC MULTI-LAYER ANIMATION SEQUENCE */

  /* Item 1: Sugar */
  .sabotage-item[data-delay="0"] .danger-glow {
    animation: dangerPulse 0.6s ease-out 0.4s forwards;
  }

  .sabotage-item[data-delay="0"] .ingredient-name {
    animation: wordShake 0.3s ease-out 0.45s;
  }

  .sabotage-item[data-delay="0"] .strike-1 {
    animation: strikethroughSlash 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.55s forwards;
  }

  .sabotage-item[data-delay="0"] .strike-2 {
    animation: strikethroughSlash 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.75s forwards;
  }

  /* Item 2: Palm Oil */
  .sabotage-item[data-delay="300"] .danger-glow {
    animation: dangerPulse 0.6s ease-out 0.7s forwards;
  }

  .sabotage-item[data-delay="300"] .ingredient-name {
    animation: wordShake 0.3s ease-out 0.75s;
  }

  .sabotage-item[data-delay="300"] .strike-1 {
    animation: strikethroughSlash 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.85s forwards;
  }

  .sabotage-item[data-delay="300"] .strike-2 {
    animation: strikethroughSlash 0.4s cubic-bezier(0.22, 1, 0.36, 1) 1.05s forwards;
  }

  /* Item 3: Salt */
  .sabotage-item[data-delay="600"] .danger-glow {
    animation: dangerPulse 0.6s ease-out 1.0s forwards;
  }

  .sabotage-item[data-delay="600"] .ingredient-name {
    animation: wordShake 0.3s ease-out 1.05s;
  }

  .sabotage-item[data-delay="600"] .strike-1 {
    animation: strikethroughSlash 0.5s cubic-bezier(0.22, 1, 0.36, 1) 1.15s forwards;
  }

  .sabotage-item[data-delay="600"] .strike-2 {
    animation: strikethroughSlash 0.4s cubic-bezier(0.22, 1, 0.36, 1) 1.35s forwards;
  }

  .sabotage-provocation {
    animation: sabotageReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) 1.5s forwards;
  }

  .sabotage-question {
    animation: sabotageReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) 1.8s forwards;
  }

  .visual-bridge {
    animation: sabotageReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) 2.1s forwards;
  }

  @keyframes sabotageReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Danger glow pulses in and stays */
  @keyframes dangerPulse {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.8);
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0.6;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }

  /* Word shakes when being attacked */
  @keyframes wordShake {
    0%, 100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-3px);
    }
    75% {
      transform: translateX(3px);
    }
  }

  /* Strikethrough slashes across */
  @keyframes strikethroughSlash {
    to {
      transform: translateY(-50%) scaleX(1);
    }
  }

  /* Second strike keeps its rotation */
  .strike-2 {
    animation-name: strikethroughSlashAngled !important;
  }

  @keyframes strikethroughSlashAngled {
    to {
      transform: translateY(-50%) rotate(-2deg) scaleX(1);
    }
  }

  /* Benefit Tiles Grid */
  .benefit-tiles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .benefit-tile {
    background: white;
    padding: 40px 32px;
    border-radius: 16px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    border-top: 4px solid #2D5F3F;
  }

  .benefit-tile:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.12);
  }

  .benefit-icon {
    font-size: 56px;
    margin-bottom: 24px;
    display: inline-block;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .benefit-tile:hover .benefit-icon {
    transform: scale(1.1);
  }

  .benefit-title {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
    color: #2C2416;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .benefit-description {
    font-size: 15px;
    color: #6B5D4F;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 768px) {
    .cuts-doesnt-section {
      padding: 70px 5%;
    }

    .ingredient-sabotage {
      margin-bottom: 0;
      padding: 50px 5% 60px;
    }

    .answer-section {
      padding: 40px 0 0 0;
      margin-top: -30px;
    }

    .bridge-arrow {
      height: 80px;
    }

    .sabotage-ingredients-horizontal {
      flex-direction: column;
      gap: 20px;
      margin-bottom: 35px;
    }

    .ingredient-name {
      font-size: clamp(32px, 10vw, 48px);
    }

    .strikethrough-bold {
      height: 6px;
    }

    .sabotage-provocation {
      font-size: 18px;
      margin-bottom: 30px;
    }

    .sabotage-question {
      font-size: clamp(28px, 8vw, 40px);
      margin-bottom: 20px;
    }

    .bridge-arrow {
      width: 40px;
      height: 60px;
    }

    .cuts-section-title {
      font-size: 30px;
    }

    .cuts-section-subtitle {
      font-size: 16px;
      margin-bottom: 40px;
    }

    .benefit-tiles-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .benefit-tile {
      padding: 32px 24px;
    }

    .benefit-icon {
      font-size: 48px;
      margin-bottom: 20px;
    }

    .benefit-title {
      font-size: 20px;
    }

    .benefit-description {
      font-size: 14px;
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .sabotage-item,
    .sabotage-provocation,
    .sabotage-question,
    .visual-bridge {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .danger-glow {
      animation: none;
      opacity: 0.6;
    }

    .ingredient-name {
      animation: none;
    }

    .strikethrough-bold {
      animation: none;
      transform: translateY(-50%) scaleX(1);
    }

    .strike-2 {
      transform: translateY(-50%) rotate(-2deg) scaleX(1);
    }

    .bridge-arrow,
    .bridge-arrow line,
    .bridge-arrow path {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
    }

    .benefit-tile {
      transition: none;
    }

    .benefit-tile:hover {
      transform: none;
    }

    .benefit-icon {
      transition: none;
    }

    .benefit-tile:hover .benefit-icon {
      transform: none;
    }
  }
</style>

