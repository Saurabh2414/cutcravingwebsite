<section class="pdp-feature-strip">
  <div class="feature-strip-container">
    {% for block in section.blocks %}
      <div class="feature-pill" data-delay="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <div class="feature-icon">
          {{ block.settings.icon }}
        </div>
        <div class="feature-text">{{ block.settings.text }}</div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .pdp-feature-strip {
    padding: 0 5% 60px;
    background: #FFF9F3;
    position: relative;
    z-index: 5;
  }

  .feature-strip-container {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .feature-pill {
    background: white;
    padding: 20px 16px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    border: 1px solid rgba(45, 95, 63, 0.1);
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    opacity: 0;
    transform: translateX(-20px);
  }

  .feature-pill.animate-in {
    opacity: 1;
    transform: translateX(0);
  }

  .feature-pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    border-color: rgba(45, 95, 63, 0.2);
  }

  .feature-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(45, 95, 63, 0.08);
    border-radius: 50%;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .feature-pill:hover .feature-icon {
    transform: scale(1.05);
  }

  .feature-icon svg,
  .feature-icon img {
    width: 18px;
    height: 18px;
  }

  .feature-text {
    font-size: 14px;
    font-weight: 600;
    color: #2C2416;
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .feature-strip-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .pdp-feature-strip {
      padding: 0 5% 40px;
    }

    .feature-pill {
      padding: 16px 14px;
    }
  }

  @media (max-width: 480px) {
    .feature-pill {
      padding: 14px 12px;
      gap: 10px;
    }

    .feature-text {
      font-size: 13px;
    }

    .feature-icon {
      width: 28px;
      height: 28px;
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .feature-pill {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .feature-pill:hover {
      transform: none;
    }

    .feature-pill:hover .feature-icon {
      transform: none;
    }
  }
</style>

<script>
  // Animate feature pills on page load
  document.addEventListener('DOMContentLoaded', function() {
    const pills = document.querySelectorAll('.feature-pill');

    // Check if user prefers reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      pills.forEach(pill => pill.classList.add('animate-in'));
      return;
    }

    pills.forEach((pill, index) => {
      setTimeout(() => {
        pill.classList.add('animate-in');
      }, index * 100);
    });
  });
</script>

