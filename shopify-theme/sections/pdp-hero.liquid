<section class="pdp-hero">
  <div class="pdp-hero-container">
    <div class="pdp-hero-visual">
      {% if section.settings.product_image %}
        <img src="{{ section.settings.product_image | img_url: '800x800' }}" alt="{{ section.settings.headline | escape }}" loading="eager" class="pdp-product-image">
      {% endif %}
    </div>

    <div class="pdp-hero-content">
      {% if section.settings.eyebrow_text %}
        <div class="pdp-hero-eyebrow">{{ section.settings.eyebrow_text }}</div>
      {% endif %}

      <h1 class="pdp-hero-headline">{{ section.settings.headline }}</h1>

      <div class="pdp-hero-price-row">
        <div class="pdp-hero-price">₹{{ section.settings.price }}</div>
        {% if section.settings.badge_text %}
          <span class="pdp-hero-badge">{{ section.settings.badge_text }}</span>
        {% endif %}
      </div>

      {% if section.settings.subheadline %}
        <p class="pdp-hero-subheadline">{{ section.settings.subheadline }}</p>
      {% endif %}

      <ul class="pdp-hero-benefits">
        {% if section.settings.benefit_1 %}<li>{{ section.settings.benefit_1 }}</li>{% endif %}
        {% if section.settings.benefit_2 %}<li>{{ section.settings.benefit_2 }}</li>{% endif %}
        {% if section.settings.benefit_3 %}<li>{{ section.settings.benefit_3 }}</li>{% endif %}
      </ul>

      <div class="pdp-hero-ctas">
        <a href="{{ section.settings.primary_cta_link }}" class="btn-primary-pdp">
          {{ section.settings.primary_cta_text }}
        </a>
      </div>

      {% if section.settings.shipping_text %}
        <div class="pdp-hero-shipping">{{ section.settings.shipping_text }}</div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .pdp-hero {
    padding: 80px 5% 60px;
    background: #FFF9F3;  /* Light cream like reference */
  }

  .pdp-hero-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: center;
  }

  .pdp-hero-eyebrow {
    font-size: 14px;
    color: #6B5D4F;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .pdp-hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.2;
    margin: 0 0 16px 0;
    letter-spacing: -0.5px;
  }

  .pdp-hero-price-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .pdp-hero-price {
    font-size: 28px;
    font-weight: 800;
    color: #2C2416;
  }

  .pdp-hero-badge {
    font-size: 13px;
    color: #6B5D4F;
    font-weight: 600;
  }

  .pdp-hero-subheadline {
    font-size: 17px;
    color: #2C2416;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .pdp-hero-benefits {
    list-style: none;
    padding: 0;
    margin: 0 0 32px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pdp-hero-benefits li {
    font-size: 15px;
    color: #2C2416;
    font-weight: 600;
    padding: 10px 16px;
    background: rgba(245, 237, 228, 0.5);
    border-radius: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
  }

  .pdp-hero-benefits li::before {
    content: "✓";
    color: #2D5F3F;
    font-weight: 700;
    font-size: 16px;
  }

  .pdp-hero-ctas {
    margin-bottom: 16px;
  }

  .btn-primary-pdp {
    display: inline-block;
    padding: 18px 48px;
    background: #2D5F3F;
    color: white;
    border-radius: 32px;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 4px 16px rgba(45, 95, 63, 0.25);
  }

  .btn-primary-pdp:hover {
    background: #234a31;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(45, 95, 63, 0.35);
  }

  .pdp-hero-shipping {
    font-size: 14px;
    color: #6B5D4F;
    font-weight: 600;
  }

  .pdp-hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pdp-product-image {
    width: 100%;
    max-width: 450px;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.12));
  }

  @media (max-width: 900px) {
    .pdp-hero-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .pdp-hero-visual {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .pdp-hero {
      padding: 60px 5% 40px;
    }

    .pdp-hero-headline {
      font-size: 32px;
      margin-bottom: 12px;
    }

    .pdp-hero-price {
      font-size: 24px;
    }

    .pdp-hero-benefits li {
      font-size: 14px;
    }

    .btn-primary-pdp {
      width: 100%;
      text-align: center;
    }

    .pdp-product-image {
      max-width: 320px;
    }
  }
</style>

{% schema %}
{
  "name": "PDP Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text (Top Label)",
      "default": "The Craving Intelligence Choice"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Product Name (Headline)",
      "default": "Stone-Ground Chocolate Peanut Butter"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price (without ₹ symbol)",
      "default": "349"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Fresh batch - Limited stock"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Designed for sweet cravings — not sugar crashes."
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "100% roasted peanuts"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "No refined sugar"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "No palm oil"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "Add to Cart — Get it by Tuesday"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping Text",
      "default": "FREE Shipping on orders above ₹499"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    }
  ],
  "presets": [
    {
      "name": "PDP Hero"
    }
  ]
}
{% endschema %}
