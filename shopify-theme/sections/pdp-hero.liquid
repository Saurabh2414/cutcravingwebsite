<section class="pdp-hero">
  <div class="pdp-hero-container">
    <div class="pdp-hero-visual" id="productRotation">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <img
            src="{{ block.settings.image | img_url: '800x800' }}"
            alt="{{ block.settings.alt_text | default: section.settings.headline | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            class="pdp-product-image {% if forloop.first %}active{% endif %}"
            data-rotation-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}>
        {% endfor %}
      {% elsif section.settings.product_image %}
        <img src="{{ section.settings.product_image | img_url: '800x800' }}" alt="{{ section.settings.headline | escape }}" loading="eager" class="pdp-product-image active">
      {% endif %}
    </div>

    <div class="pdp-hero-content">
      {% if section.settings.eyebrow_text %}
        <div class="pdp-hero-eyebrow">{{ section.settings.eyebrow_text }}</div>
      {% endif %}

      <h1 class="pdp-hero-headline">{{ section.settings.headline }}</h1>

      <div class="pdp-hero-price-row">
        <div class="pdp-hero-price">₹{{ section.settings.price }}</div>
        {% if section.settings.badge_text %}
          <span class="pdp-hero-badge">{{ section.settings.badge_text }}</span>
        {% endif %}
      </div>

      {% if section.settings.subheadline %}
        <p class="pdp-hero-subheadline">{{ section.settings.subheadline }}</p>
      {% endif %}

      <ul class="pdp-hero-benefits">
        {% if section.settings.benefit_1 %}<li>{{ section.settings.benefit_1 }}</li>{% endif %}
        {% if section.settings.benefit_2 %}<li>{{ section.settings.benefit_2 }}</li>{% endif %}
        {% if section.settings.benefit_3 %}<li>{{ section.settings.benefit_3 }}</li>{% endif %}
      </ul>

      <div class="pdp-hero-ctas">
        <a href="{{ section.settings.primary_cta_link }}" class="btn-primary-pdp">
          <span class="btn-text">{{ section.settings.primary_cta_text }}</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>

      {% if section.settings.shipping_text %}
        <div class="pdp-hero-shipping">{{ section.settings.shipping_text }}</div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .pdp-hero {
    padding: 100px 5% 80px;
    background: #FFF9F3;
    position: relative;
    overflow: hidden;
  }

  /* Premium contrast band behind product */
  .pdp-hero::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 45%;
    height: 100%;
    background: linear-gradient(135deg, #F5EDE4 0%, #EDE3D5 100%);
    z-index: 0;
  }

  .pdp-hero-container {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .pdp-hero-eyebrow {
    font-size: 14px;
    color: #6B5D4F;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .pdp-hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.2;
    margin: 0 0 16px 0;
    letter-spacing: -0.5px;
  }

  .pdp-hero-price-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .pdp-hero-price {
    font-size: 28px;
    font-weight: 800;
    color: #2C2416;
  }

  .pdp-hero-badge {
    font-size: 13px;
    color: #6B5D4F;
    font-weight: 600;
  }

  .pdp-hero-subheadline {
    font-size: 17px;
    color: #2C2416;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .pdp-hero-benefits {
    list-style: none;
    padding: 0;
    margin: 0 0 32px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pdp-hero-benefits li {
    font-size: 15px;
    color: #2C2416;
    font-weight: 600;
    padding: 10px 16px;
    background: rgba(245, 237, 228, 0.5);
    border-radius: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
  }

  .pdp-hero-benefits li::before {
    content: "✓";
    color: #2D5F3F;
    font-weight: 700;
    font-size: 16px;
  }

  .pdp-hero-ctas {
    margin-bottom: 16px;
  }

  .btn-primary-pdp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 18px 48px;
    background: #2D5F3F;
    color: white;
    border-radius: 32px;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 4px 16px rgba(45, 95, 63, 0.25);
    position: relative;
    overflow: hidden;
  }

  .btn-primary-pdp::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 32px;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .btn-primary-pdp:hover::before {
    opacity: 1;
  }

  .btn-primary-pdp:hover {
    background: #234a31;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(45, 95, 63, 0.4);
  }

  .btn-arrow {
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    display: inline-block;
  }

  .btn-primary-pdp:hover .btn-arrow {
    transform: translateX(4px);
  }

  .btn-primary-pdp:active {
    transform: scale(0.97) translateY(-1px);
  }

  .pdp-hero-shipping {
    font-size: 14px;
    color: #6B5D4F;
    font-weight: 600;
  }

  .pdp-hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 520px;
  }

  .pdp-product-image {
    width: 100%;
    max-width: 520px;  /* Increased by ~15% */
    height: auto;
    filter: drop-shadow(0 16px 40px rgba(44, 36, 22, 0.15))
            drop-shadow(0 4px 12px rgba(44, 36, 22, 0.08));
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    cursor: zoom-in;
  }

  .pdp-product-image.active {
    opacity: 1;
  }

  .pdp-product-image:hover {
    transform: translate(-50%, -50%) rotateY(2deg) translateY(-8px);
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .pdp-product-image {
      transition: none;
      opacity: 1 !important;
    }

    .pdp-product-image:hover {
      transform: translate(-50%, -50%);
    }
  }

  @media (max-width: 900px) {
    .pdp-hero-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .pdp-hero-visual {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .pdp-hero {
      padding: 60px 5% 40px;
    }

    .pdp-hero-headline {
      font-size: 32px;
      margin-bottom: 12px;
    }

    .pdp-hero-price {
      font-size: 24px;
    }

    .pdp-hero-benefits li {
      font-size: 14px;
    }

    .btn-primary-pdp {
      width: 100%;
      text-align: center;
    }

    .pdp-product-image {
      max-width: 320px;
    }
  }
</style>

<script>
  (function() {
    const rotationContainer = document.getElementById('productRotation');
    if (!rotationContainer) return;

    const images = rotationContainer.querySelectorAll('.pdp-product-image');
    if (images.length <= 1) return;

    let currentIndex = 0;
    let rotationInterval;

    // Check if user prefers reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      // Show only first image, no rotation
      return;
    }

    function rotateToNext() {
      // Fade out current
      images[currentIndex].classList.remove('active');

      // Move to next
      currentIndex = (currentIndex + 1) % images.length;

      // Fade in next
      images[currentIndex].classList.add('active');
    }

    // Auto-rotate every 3.5 seconds
    function startRotation() {
      rotationInterval = setInterval(rotateToNext, 3500);
    }

    // Pause on hover (optional enhancement)
    rotationContainer.addEventListener('mouseenter', function() {
      clearInterval(rotationInterval);
    });

    rotationContainer.addEventListener('mouseleave', function() {
      startRotation();
    });

    // Start rotation after page load
    setTimeout(startRotation, 2000);
  })();
</script>

{% schema %}
{
  "name": "PDP Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text (Top Label)",
      "default": "The Craving Intelligence Choice"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Product Name (Headline)",
      "default": "Stone-Ground Chocolate Peanut Butter"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price (without ₹ symbol)",
      "default": "349"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Fresh batch - Limited stock"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "For sweet cravings that don't betray you later."
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "100% roasted peanuts"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "No refined sugar"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "No palm oil"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "Add to Cart — Get it by Tuesday"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping Text",
      "default": "FREE Shipping on orders above ₹499"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image (Fallback - use blocks instead)"
    }
  ],
  "blocks": [
    {
      "type": "rotation_image",
      "name": "Product Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text (Optional)",
          "info": "Leave blank to use product headline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Hero",
      "blocks": [
        {
          "type": "rotation_image"
        },
        {
          "type": "rotation_image"
        },
        {
          "type": "rotation_image"
        },
        {
          "type": "rotation_image"
        }
      ]
    }
  ]
}
{% endschema %}
