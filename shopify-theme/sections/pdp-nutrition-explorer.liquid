<section class="nutrition-explorer">
  <div class="nutrition-container">
    <h2 class="nutrition-title">{{ section.settings.title }}</h2>

    <div class="nutrition-grid">
      {% for block in section.blocks %}
        <div class="nutrition-item {% if block.type == 'excluded_item' %}excluded{% endif %}" {{ block.shopify_attributes }}>
          <div class="nutrition-icon-wrapper">
            <div class="nutrition-icon">{{ block.settings.icon }}</div>
            {% if block.type == 'excluded_item' %}
              <div class="nutrition-cross">×</div>
            {% endif %}
          </div>
          <div class="nutrition-name">{{ block.settings.name }}</div>
          {% if block.settings.why %}
            <div class="nutrition-why">{{ block.settings.why }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_full_table_toggle %}
      <button class="nutrition-toggle" onclick="toggleNutritionTable()">
        {{ section.settings.toggle_text }}
      </button>
      <div class="nutrition-table-expanded" id="nutritionTable" style="display: none;">
        <p>{{ section.settings.full_table_content }}</p>
      </div>
    {% endif %}
  </div>
</section>

<script>
  function toggleNutritionTable() {
    const table = document.getElementById('nutritionTable');
    const button = event.target;
    if (table.style.display === 'none') {
      table.style.display = 'block';
      button.textContent = 'Hide nutritional table ↑';
    } else {
      table.style.display = 'none';
      button.textContent = 'View full nutritional table →';
    }
  }
</script>

<style>
  .nutrition-explorer {
    padding: 100px 5%;
    background: #FFF9F3;
  }

  .nutrition-container {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .nutrition-title {
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.3;
    margin: 0 0 50px 0;
  }

  .nutrition-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin-bottom: 50px;
    background: white;
    padding: 50px 40px;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }

  .nutrition-item {
    text-align: center;
  }

  .nutrition-icon-wrapper {
    position: relative;
    display: inline-block;
    margin-bottom: 16px;
  }

  .nutrition-icon {
    font-size: 48px;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.1));
  }

  .nutrition-cross {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 72px;
    font-weight: 300;
    color: #D32F2F;
    opacity: 0.9;
    pointer-events: none;
  }

  .nutrition-item.excluded .nutrition-icon {
    opacity: 0.4;
    filter: grayscale(50%) drop-shadow(0 2px 8px rgba(0,0,0,0.1));
  }

  .nutrition-name {
    font-size: 15px;
    font-weight: 700;
    color: #2C2416;
    margin-bottom: 6px;
  }

  .nutrition-item.excluded .nutrition-name {
    color: #6B5D4F;
    text-decoration: line-through;
  }

  .nutrition-why {
    font-size: 13px;
    color: #6B5D4F;
    line-height: 1.5;
  }

  .nutrition-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 auto;
    background: transparent;
    border: none;
    color: #6B5D4F;
    padding: 8px 0;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }

  .nutrition-toggle:hover {
    color: #2D5F3F;
  }

  .nutrition-table-expanded {
    max-width: 700px;
    margin: 24px auto 0;
    padding: 30px;
    background: #F5EDE4;
    border-radius: 12px;
    font-size: 15px;
    line-height: 1.8;
    color: #2C2416;
    text-align: left;
  }

  @media (max-width: 900px) {
    .nutrition-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }
  }

  @media (max-width: 768px) {
    .nutrition-explorer {
      padding: 60px 5%;
    }

    .nutrition-title {
      font-size: 28px;
    }

    .nutrition-grid {
      padding: 40px 24px;
    }

    .nutrition-icon {
      font-size: 40px;
    }

    .nutrition-cross {
      font-size: 60px;
    }
  }
</style>

