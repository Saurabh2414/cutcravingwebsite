<section class="nutrition-explorer">
  <div class="nutrition-container">
    <h2 class="nutrition-title">{{ section.settings.title }}</h2>

    <div class="nutrition-grid">
      {% for block in section.blocks %}
        {% if block.type == 'inside_item' %}
          <div class="nutrition-item" {{ block.shopify_attributes }}>
            <div class="nutrition-icon">{{ block.settings.icon }}</div>
            <div class="nutrition-name">{{ block.settings.name }}</div>
            {% if block.settings.why %}
              <div class="nutrition-why">{{ block.settings.why }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% assign has_excluded = false %}
    {% for block in section.blocks %}
      {% if block.type == 'excluded_item' %}
        {% assign has_excluded = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_excluded %}
      <div class="nutrition-excluded-strip">
        <div class="excluded-label">What's NOT inside:</div>
        <div class="excluded-items">
          {% for block in section.blocks %}
            {% if block.type == 'excluded_item' %}
              <div class="excluded-item" {{ block.shopify_attributes }}>
                <span class="excluded-cross">×</span>
                <span class="excluded-name">{{ block.settings.name }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if section.settings.show_full_table_toggle %}
      <button class="nutrition-toggle" onclick="toggleNutritionTable()">
        {{ section.settings.toggle_text }}
      </button>
      <div class="nutrition-table-expanded" id="nutritionTable" style="display: none;">
        <p>{{ section.settings.full_table_content }}</p>
      </div>
    {% endif %}
  </div>
</section>

<script>
  function toggleNutritionTable() {
    const table = document.getElementById('nutritionTable');
    const button = event.target;
    if (table.style.display === 'none') {
      table.style.display = 'block';
      button.textContent = 'Hide nutritional table ↑';
    } else {
      table.style.display = 'none';
      button.textContent = 'View full nutritional table →';
    }
  }
</script>

<style>
  .nutrition-explorer {
    padding: 100px 5%;
    background: #FFF9F3;
  }

  .nutrition-container {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .nutrition-title {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.3;
    margin: 0 0 50px 0;
    letter-spacing: -0.5px;
  }

  .nutrition-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-bottom: 32px;
    background: white;
    padding: 56px 44px;
    border-radius: 16px;
    box-shadow: 0 6px 28px rgba(0,0,0,0.08);
  }

  .nutrition-item {
    text-align: center;
  }

  .nutrition-icon {
    font-size: 52px;
    margin-bottom: 16px;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.1));
  }

  .nutrition-name {
    font-size: 16px;
    font-weight: 700;
    color: #2C2416;
    margin-bottom: 8px;
  }

  .nutrition-why {
    font-size: 14px;
    color: #6B5D4F;
    line-height: 1.6;
  }

  .nutrition-excluded-strip {
    background: rgba(211, 47, 47, 0.04);
    padding: 20px 28px;
    border-radius: 12px;
    border-left: 3px solid rgba(211, 47, 47, 0.3);
    margin-bottom: 40px;
  }

  .excluded-label {
    font-size: 13px;
    font-weight: 700;
    color: #6B5D4F;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }

  .excluded-items {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 20px;
    justify-content: center;
  }

  .excluded-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: #6B5D4F;
  }

  .excluded-cross {
    color: #D32F2F;
    font-weight: 700;
    font-size: 18px;
  }

  .excluded-name {
    text-decoration: line-through;
  }

  .nutrition-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 auto;
    background: transparent;
    border: none;
    color: #6B5D4F;
    padding: 8px 0;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }

  .nutrition-toggle:hover {
    color: #2D5F3F;
  }

  .nutrition-table-expanded {
    max-width: 700px;
    margin: 24px auto 0;
    padding: 30px;
    background: #F5EDE4;
    border-radius: 12px;
    font-size: 15px;
    line-height: 1.8;
    color: #2C2416;
    text-align: left;
  }

  @media (max-width: 900px) {
    .nutrition-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 768px) {
    .nutrition-explorer {
      padding: 70px 5%;
    }

    .nutrition-title {
      font-size: 32px;
    }

    .nutrition-grid {
      padding: 44px 28px;
      gap: 28px;
    }

    .nutrition-icon {
      font-size: 44px;
    }

    .excluded-items {
      gap: 12px 16px;
    }

    .excluded-item {
      font-size: 13px;
    }
  }
</style>

