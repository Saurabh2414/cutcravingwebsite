<section class="portion-intelligence">
  <div class="portion-container">
    <h2 class="portion-title">{{ section.settings.title }}</h2>
    <p class="portion-intro">{{ section.settings.intro_line }}</p>

    <div class="portion-slider-wrapper">
      <div class="portion-display">
        <div class="portion-amount" id="portionAmount">2 tbsp</div>
      </div>

      <div class="portion-labels">
        <div class="portion-label-item">
          <span>Light craving</span>
        </div>
        <div class="portion-label-item active" id="label-2">
          <span>Sweet craving</span>
        </div>
        <div class="portion-label-item">
          <span>Heavy urge</span>
        </div>
      </div>

      <input type="range" min="1" max="3" value="2" class="portion-slider" id="portionSlider">
    </div>

    {% if section.settings.show_insight %}
      <p class="portion-insight">{{ section.settings.insight_text }}</p>
    {% endif %}

    <button class="portion-reset" onclick="resetSlider()">
      <span class="reset-icon">↻</span> {{ section.settings.reset_text }}
    </button>
  </div>
</section>

<script>
  const slider = document.getElementById('portionSlider');
  const amount = document.getElementById('portionAmount');

  const portions = {
    1: '1 tbsp',
    2: '2 tbsp',
    3: '3 tbsp'
  };

  slider.addEventListener('input', (e) => {
    const value = e.target.value;
    amount.textContent = portions[value];

    // Update active label
    document.querySelectorAll('.portion-label-item').forEach((item, index) => {
      item.classList.toggle('active', index + 1 == value);
    });
  });

  function resetSlider() {
    slider.value = 2;
    amount.textContent = portions[2];
    document.querySelectorAll('.portion-label-item').forEach((item, index) => {
      item.classList.toggle('active', index + 1 == 2);
    });
  }
</script>

<style>
  .portion-intelligence {
    padding: 100px 5%;
    background: #FFF9F3;
  }

  .portion-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .portion-title {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.3;
    margin: 0 0 20px 0;
    letter-spacing: -0.5px;
  }

  .portion-intro {
    font-size: 19px;
    color: #6B5D4F;
    margin-bottom: 50px;
    line-height: 1.5;
    font-style: italic;
  }

  .portion-slider-wrapper {
    background: white;
    padding: 60px 70px 50px;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    margin-bottom: 32px;
  }

  .portion-display {
    margin-bottom: 40px;
  }

  .portion-amount {
    font-size: 82px;
    font-weight: 900;
    color: #2D5F3F;
    margin-bottom: 0;
    letter-spacing: -1px;
    text-shadow: 0 2px 8px rgba(45, 95, 63, 0.1);
  }

  .portion-labels {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    gap: 12px;
  }

  .portion-label-item {
    flex: 1;
    text-align: center;
    padding: 10px;
    font-size: 15px;
    color: #6B5D4F;
    font-weight: 600;
    transition: all 0.3s;
    border-radius: 8px;
  }

  .portion-label-item.active {
    color: #2D5F3F;
    font-weight: 800;
    background: rgba(45, 95, 63, 0.05);
  }

  .portion-slider {
    width: 100%;
    height: 12px;
    background: linear-gradient(to right,
      #2D5F3F 0%,
      #2D5F3F 50%,
      #E5DDD4 50%,
      #E5DDD4 100%
    );
    border-radius: 12px;
    outline: none;
    cursor: pointer;
    -webkit-appearance: none;
  }

  .portion-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #2D5F3F;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(45, 95, 63, 0.5);
    border: 5px solid white;
    transition: all 0.2s;
  }

  .portion-slider::-webkit-slider-thumb:hover {
    transform: scale(1.1);
  }

  .portion-slider::-moz-range-thumb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #2D5F3F;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(45, 95, 63, 0.5);
    border: 5px solid white;
    transition: all 0.2s;
  }

  .portion-slider::-moz-range-thumb:hover {
    transform: scale(1.1);
  }

  .portion-insight {
    font-size: 16px;
    color: #6B5D4F;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .portion-reset {
    background: transparent;
    border: none;
    color: #6B5D4F;
    padding: 8px 0;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .portion-reset:hover {
    color: #2D5F3F;
  }

  .reset-icon {
    font-size: 16px;
  }

  @media (max-width: 768px) {
    .portion-intelligence {
      padding: 70px 5%;
    }

    .portion-title {
      font-size: 32px;
    }

    .portion-intro {
      font-size: 17px;
      margin-bottom: 40px;
    }

    .portion-slider-wrapper {
      padding: 44px 32px 40px;
    }

    .portion-amount {
      font-size: 56px;
    }

    .portion-label-item {
      font-size: 13px;
      padding: 8px 4px;
    }

    .portion-slider::-webkit-slider-thumb {
      width: 36px;
      height: 36px;
    }

    .portion-slider::-moz-range-thumb {
      width: 36px;
      height: 36px;
    }
  }
</style>

{% schema %}
{
  "name": "PDP Portion Intelligence",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Section Title",
      "default": "How much satisfaction do you actually need?"
    },
    {
      "type": "text",
      "id": "intro_line",
      "label": "Intro Line",
      "default": "Satisfaction is not unlimited. It's precise."
    },
    {
      "type": "checkbox",
      "id": "show_insight",
      "label": "Show Insight Text",
      "default": false
    },
    {
      "type": "text",
      "id": "insight_text",
      "label": "Insight Text",
      "default": "Most people don't need more food. They need the right dose."
    },
    {
      "type": "text",
      "id": "reset_text",
      "label": "Reset Button Text",
      "default": "Reset to 2 tbsp (recommended)"
    }
  ],
  "presets": [
    {
      "name": "PDP Portion Intelligence"
    }
  ]
}
{% endschema %}
