<section class="portion-intelligence">
  <div class="portion-container">
    <h2 class="portion-title">{{ section.settings.title }}</h2>

    <div class="portion-slider-wrapper">
      <div class="portion-display">
        <div class="portion-amount" id="portionAmount">2 tbsp</div>
      </div>

      <div class="portion-labels">
        <div class="portion-label-item">
          <span>Light craving</span>
        </div>
        <div class="portion-label-item active" id="label-2">
          <span>Sweet craving</span>
        </div>
        <div class="portion-label-item">
          <span>Heavy urge</span>
        </div>
      </div>

      <input type="range" min="1" max="3" value="2" class="portion-slider" id="portionSlider">
    </div>

    <p class="portion-insight">{{ section.settings.insight_line1 }}<br>{{ section.settings.insight_line2 }}</p>

    <button class="portion-reset" onclick="resetSlider()">
      <span class="reset-icon">↻</span> {{ section.settings.reset_text }}
    </button>
  </div>
</section>

<script>
  const slider = document.getElementById('portionSlider');
  const amount = document.getElementById('portionAmount');

  const portions = {
    1: '1 tbsp',
    2: '2 tbsp',
    3: '3 tbsp'
  };

  slider.addEventListener('input', (e) => {
    const value = e.target.value;
    amount.textContent = portions[value];

    // Update active label
    document.querySelectorAll('.portion-label-item').forEach((item, index) => {
      item.classList.toggle('active', index + 1 == value);
    });
  });

  function resetSlider() {
    slider.value = 2;
    amount.textContent = portions[2];
    document.querySelectorAll('.portion-label-item').forEach((item, index) => {
      item.classList.toggle('active', index + 1 == 2);
    });
  }
</script>

<style>
  .portion-intelligence {
    padding: 100px 5%;
    background: #FFF9F3;
  }

  .portion-container {
    max-width: 750px;
    margin: 0 auto;
    text-align: center;
  }

  .portion-title {
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.3;
    margin: 0 0 50px 0;
  }

  .portion-slider-wrapper {
    background: #F5EDE4;
    padding: 50px 60px 40px;
    border-radius: 16px;
    margin-bottom: 32px;
  }

  .portion-display {
    margin-bottom: 30px;
  }

  .portion-amount {
    font-size: 52px;
    font-weight: 800;
    color: #2D5F3F;
    margin-bottom: 0;
  }

  .portion-labels {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .portion-label-item {
    flex: 1;
    text-align: center;
    padding: 8px;
    font-size: 15px;
    color: #6B5D4F;
    font-weight: 600;
    transition: all 0.3s;
  }

  .portion-label-item.active {
    color: #2C2416;
    font-weight: 700;
  }

  .portion-slider {
    width: 100%;
    height: 10px;
    background: linear-gradient(to right,
      #2D5F3F 0%,
      #2D5F3F 50%,
      #E5DDD4 50%,
      #E5DDD4 100%
    );
    border-radius: 10px;
    outline: none;
    cursor: pointer;
    -webkit-appearance: none;
  }

  .portion-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #2D5F3F;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(45, 95, 63, 0.4);
    border: 4px solid white;
  }

  .portion-slider::-moz-range-thumb {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #2D5F3F;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(45, 95, 63, 0.4);
    border: 4px solid white;
  }

  .portion-insight {
    font-size: 17px;
    color: #2C2416;
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .portion-reset {
    background: transparent;
    border: none;
    color: #6B5D4F;
    padding: 8px 0;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .portion-reset:hover {
    color: #2D5F3F;
  }

  .reset-icon {
    font-size: 16px;
  }

  @media (max-width: 768px) {
    .portion-intelligence {
      padding: 60px 5%;
    }

    .portion-title {
      font-size: 28px;
    }

    .portion-slider-wrapper {
      padding: 40px 32px 32px;
    }

    .portion-amount {
      font-size: 40px;
    }

    .portion-label-item {
      font-size: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "PDP Portion Intelligence",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Section Title",
      "default": "How much satisfaction do you actually need?"
    },
    {
      "type": "text",
      "id": "insight_line1",
      "label": "Insight Line 1",
      "default": "Most people don't need more food."
    },
    {
      "type": "text",
      "id": "insight_line2",
      "label": "Insight Line 2",
      "default": "They need the right dose."
    },
    {
      "type": "text",
      "id": "reset_text",
      "label": "Reset Button Text",
      "default": "Reset to 2 tbsp (recommended)"
    }
  ],
  "presets": [
    {
      "name": "PDP Portion Intelligence"
    }
  ]
}
{% endschema %}
