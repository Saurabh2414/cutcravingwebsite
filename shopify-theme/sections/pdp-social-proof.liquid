<section class="pdp-social-proof">
  <div class="social-proof-container">
    <h2 class="social-proof-title">{{ section.settings.title }}</h2>
    <p class="social-proof-subtitle">{{ section.settings.subtitle }}</p>

    <div class="testimonials-grid">
      {% for block in section.blocks %}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-quote">"{{ block.settings.quote }}"</div>
          <div class="testimonial-meta">
            <div class="testimonial-name">{{ block.settings.name }}</div>
            {% if block.settings.time_moment %}
              <div class="testimonial-moment">{{ block.settings.time_moment }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_stats %}
      <div class="social-proof-stats">
        {% if section.settings.stat_1_number %}
          <div class="stat-item">
            <div class="stat-number">{{ section.settings.stat_1_number }}</div>
            <div class="stat-label">{{ section.settings.stat_1_label }}</div>
          </div>
        {% endif %}
        {% if section.settings.stat_2_number %}
          <div class="stat-item">
            <div class="stat-number">{{ section.settings.stat_2_number }}</div>
            <div class="stat-label">{{ section.settings.stat_2_label }}</div>
          </div>
        {% endif %}
        {% if section.settings.stat_3_number %}
          <div class="stat-item">
            <div class="stat-number">{{ section.settings.stat_3_number }}</div>
            <div class="stat-label">{{ section.settings.stat_3_label }}</div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .pdp-social-proof {
    padding: 100px 5%;
    background: #FFF9F3;
  }

  .social-proof-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .social-proof-title {
    font-family: 'Playfair Display', serif;
    font-size: 38px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.3;
    margin: 0 0 16px 0;
    text-align: center;
  }

  .social-proof-subtitle {
    font-size: 17px;
    color: #6B5D4F;
    line-height: 1.7;
    margin-bottom: 60px;
    text-align: center;
    font-style: italic;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    margin-bottom: 60px;
  }

  .testimonial-card {
    background: white;
    padding: 32px 28px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    border-left: 4px solid #2D5F3F;
    transition: all 0.3s;
  }

  .testimonial-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0,0,0,0.1);
  }

  .testimonial-quote {
    font-size: 16px;
    color: #2C2416;
    line-height: 1.7;
    margin-bottom: 20px;
    font-style: italic;
  }

  .testimonial-meta {
    padding-top: 16px;
    border-top: 1px solid #E5DDD4;
  }

  .testimonial-name {
    font-size: 14px;
    font-weight: 700;
    color: #2C2416;
    margin-bottom: 4px;
  }

  .testimonial-moment {
    font-size: 12px;
    color: #2D5F3F;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .social-proof-stats {
    display: flex;
    justify-content: center;
    gap: 60px;
    flex-wrap: wrap;
    padding-top: 40px;
    border-top: 2px solid #E5DDD4;
  }

  .stat-item {
    text-align: center;
  }

  .stat-number {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    font-weight: 800;
    color: #2D5F3F;
    margin-bottom: 8px;
  }

  .stat-label {
    font-size: 14px;
    color: #6B5D4F;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  @media (max-width: 768px) {
    .pdp-social-proof {
      padding: 60px 5%;
    }

    .social-proof-title {
      font-size: 28px;
    }

    .testimonials-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .social-proof-stats {
      gap: 40px;
    }

    .stat-number {
      font-size: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "PDP Social Proof",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Section Title",
      "default": "What actually changed"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Not taste reviews. Behavior shifts."
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show Statistics Section",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Stat 1 Number",
      "default": "78%"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "stopped afternoon binges"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 Number",
      "default": "2 tbsp"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "average serving size"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Stat 3 Number",
      "default": "4+ hrs"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "satiety duration"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I stopped ordering sweets at 5 PM."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Priya M."
        },
        {
          "type": "text",
          "id": "time_moment",
          "label": "Time/Moment (optional)",
          "default": "After-lunch cravings"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Social Proof",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "I stopped ordering sweets at 5 PM.",
            "name": "Priya M.",
            "time_moment": "After-lunch cravings"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "One spoon is enough now. Before, I'd finish the whole jar.",
            "name": "Rohan K.",
            "time_moment": "Post-dinner dessert"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "My 4 PM vending machine trips just... stopped.",
            "name": "Anjali S.",
            "time_moment": "Work snack breaks"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "I don't feel guilty anymore. This is actual nutrition.",
            "name": "Karan P.",
            "time_moment": "Evening snacking"
          }
        }
      ]
    }
  ]
}
{% endschema %}
