<section class="platforms-section" style="padding: {{ section.settings.section_padding }}px 5%; background: {{ section.settings.background_color }};">
  <div class="platforms-container">
    <div class="platforms-header">
      <div class="platforms-kicker">{{ section.settings.kicker }}</div>
      <h2 class="platforms-title">{{ section.settings.title }}</h2>
      <p class="platforms-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="platforms-grid">
      {% for block in section.blocks %}
        {% if block.type == 'platform' %}
          <a href="{{ block.settings.link }}" {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %} class="platform-card {{ block.settings.platform_class }}" {{ block.shopify_attributes }}>
            {% if block.settings.special_badge %}
              <div class="platform-special">{{ block.settings.special_badge }}</div>
            {% endif %}
            <div class="platform-logo">
              {{ block.settings.logo_text }}
            </div>
            <div class="platform-badge">
              {{ block.settings.badge_text }}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.bottom_cta %}
      <div class="platforms-bottom-cta">
        {{ section.settings.bottom_cta }}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .platforms-section {
    padding: 80px 5%;
  }

  .platforms-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .platforms-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .platforms-kicker {
    font-size: 12px;
    letter-spacing: 2px;
    color: {{ section.settings.kicker_color }};
    font-weight: 700;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .platforms-title {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    margin: 0 0 16px 0;
    letter-spacing: -0.5px;
  }

  .platforms-subtitle {
    font-size: 18px;
    color: {{ section.settings.subtitle_color }};
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto;
  }

  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .platform-card {
    position: relative;
    background: {{ section.settings.card_bg_color }};
    padding: 40px 24px;
    border-radius: 16px;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .platform-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.15);
  }

  .platform-special {
    position: absolute;
    top: 12px;
    right: 12px;
    background: {{ section.settings.special_badge_bg }};
    color: {{ section.settings.special_badge_text }};
    padding: 6px 12px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .platform-logo {
    font-size: 28px;
    font-weight: 800;
    color: #2C2416;
    margin-bottom: 16px;
    line-height: 1.3;
  }

  .platform-badge {
    font-size: 14px;
    font-weight: 600;
    color: #6B5D4F;
    transition: color 0.3s;
  }

  .platform-card:hover .platform-badge {
    color: {{ section.settings.hover_badge_color }};
  }

  /* Platform-specific colors */
  .platform-card.amazon:hover {
    border-color: #FF9900;
  }

  .platform-card.amazon .platform-logo {
    color: #FF9900;
  }

  .platform-card.flipkart:hover {
    border-color: #2874F0;
  }

  .platform-card.flipkart .platform-logo {
    color: #2874F0;
  }

  .platform-card.meesho:hover {
    border-color: #9F2089;
  }

  .platform-card.meesho .platform-logo {
    color: #9F2089;
  }

  .platform-card.website:hover {
    border-color: #3D5F4A;
  }

  .platform-card.website .platform-logo {
    color: #3D5F4A;
  }

  .platforms-bottom-cta {
    text-align: center;
    font-size: 16px;
    color: {{ section.settings.bottom_cta_color }};
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .platforms-grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .platform-card {
      padding: 30px 16px;
    }

    .platform-logo {
      font-size: 22px;
    }

    .platforms-title {
      font-size: calc({{ section.settings.title_size }}px * 0.8);
    }
  }
</style>

{% schema %}
{
  "name": "Platforms Section",
  "settings": [
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding",
      "min": 40,
      "max": 120,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F5EDE4"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "default": "SHOP YOUR WAY"
    },
    {
      "type": "color",
      "id": "kicker_color",
      "label": "Kicker Color",
      "default": "#8B7355"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Available Wherever You Shop"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 28,
      "max": 56,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#2C2416"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Choose your preferred shopping platform — same quality, same freshness, delivered to your door"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#6B5D4F"
    },
    {
      "type": "header",
      "content": "Platform Cards"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "hover_badge_color",
      "label": "Badge Color on Hover",
      "default": "#3D5F4A"
    },
    {
      "type": "header",
      "content": "Special Badge"
    },
    {
      "type": "color",
      "id": "special_badge_bg",
      "label": "Special Badge Background",
      "default": "#FFD700"
    },
    {
      "type": "color",
      "id": "special_badge_text",
      "label": "Special Badge Text",
      "default": "#2C2416"
    },
    {
      "type": "header",
      "content": "Bottom CTA"
    },
    {
      "type": "textarea",
      "id": "bottom_cta",
      "label": "Bottom CTA Text (optional)",
      "default": "💚 Buying direct? You get the freshest batches, best prices, and support our small team."
    },
    {
      "type": "color",
      "id": "bottom_cta_color",
      "label": "Bottom CTA Color",
      "default": "#6B5D4F"
    }
  ],
  "blocks": [
    {
      "type": "platform",
      "name": "Platform Card",
      "settings": [
        {
          "type": "text",
          "id": "logo_text",
          "label": "Platform Name",
          "default": "Amazon"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Platform Link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in New Tab",
          "default": true
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "Shop Now →"
        },
        {
          "type": "select",
          "id": "platform_class",
          "label": "Platform Style",
          "options": [
            {"value": "amazon", "label": "Amazon (Orange)"},
            {"value": "flipkart", "label": "Flipkart (Blue)"},
            {"value": "meesho", "label": "Meesho (Purple)"},
            {"value": "website", "label": "Website (Green)"}
          ],
          "default": "amazon"
        },
        {
          "type": "text",
          "id": "special_badge",
          "label": "Special Badge (optional, e.g., 'Best Price')",
          "info": "Leave empty for no special badge"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Platforms Section",
      "blocks": [
        {
          "type": "platform",
          "settings": {
            "logo_text": "Amazon",
            "badge_text": "Shop Now →",
            "platform_class": "amazon",
            "new_tab": true
          }
        },
        {
          "type": "platform",
          "settings": {
            "logo_text": "Flipkart",
            "badge_text": "Shop Now →",
            "platform_class": "flipkart",
            "new_tab": true
          }
        },
        {
          "type": "platform",
          "settings": {
            "logo_text": "Meesho",
            "badge_text": "Shop Now →",
            "platform_class": "meesho",
            "new_tab": true
          }
        },
        {
          "type": "platform",
          "settings": {
            "logo_text": "CutCraving.com",
            "badge_text": "⭐ Direct",
            "platform_class": "website",
            "special_badge": "Best Price",
            "new_tab": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
