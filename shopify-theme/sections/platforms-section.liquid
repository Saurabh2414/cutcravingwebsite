<section class="platforms-section" style="padding: {{ section.settings.section_padding }}px 5%; background: {{ section.settings.background_color }};">
  <div class="platforms-container">
    <div class="platforms-header">
      <div class="platforms-kicker">{{ section.settings.kicker }}</div>
      <h2 class="platforms-title">{{ section.settings.title }}</h2>
      <p class="platforms-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="platforms-grid">
      {% for block in section.blocks %}
        {% if block.type == 'platform' %}
          <a href="{{ block.settings.link }}" {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %} class="platform-card {{ block.settings.platform_class }}" {{ block.shopify_attributes }}>
            {% if block.settings.special_badge %}
              <div class="platform-special">{{ block.settings.special_badge }}</div>
            {% endif %}
            <div class="platform-logo">
              {% if block.settings.logo_image %}
                <img src="{{ block.settings.logo_image | img_url: '200x200' }}" alt="{{ block.settings.logo_text | escape }}" loading="lazy" class="platform-logo-image">
              {% else %}
                {{ block.settings.logo_text }}
              {% endif %}
            </div>
            <div class="platform-badge">
              {{ block.settings.badge_text }}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.bottom_cta %}
      <div class="platforms-bottom-cta">
        {{ section.settings.bottom_cta }}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .platforms-section {
    padding: 60px 5%;
    background: #FFFFFF;
    border-top: 1px solid rgba(139, 111, 71, 0.1);
    border-bottom: 1px solid rgba(139, 111, 71, 0.1);
  }

  .platforms-container {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .platforms-header {
    margin-bottom: 40px;
  }

  .platforms-kicker {
    font-size: 11px;
    font-weight: 700;
    color: #2D5F3F;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .platforms-title {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    color: #2C2416;
    margin-bottom: 12px;
  }

  .platforms-subtitle {
    font-size: 15px;
    color: #6B5D4F;
    max-width: 600px;
    margin: 0 auto;
  }

  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 30px;
  }

  .platform-card {
    position: relative;
    background: #F5EDE4;
    padding: 32px 20px;
    border-radius: 12px;
    text-align: center;
    text-decoration: none;
    transition: all 0.3s;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    border: 2px solid transparent;
  }

  .platform-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
    border-color: #2D5F3F;
    background: white;
  }

  .platform-special {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #D4A574;
    color: white;
    font-size: 10px;
    padding: 4px 8px;
    border-radius: 12px;
    font-weight: 700;
  }

  .platform-logo {
    width: 100%;
    max-width: 140px;
    height: 60px;
    background: white;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px;
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
    color: #2C2416;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: all 0.3s;
  }

  .platform-card:hover .platform-logo {
    transform: scale(1.05);
  }

  .platform-logo-image {
    max-width: 120px;
    max-height: 60px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .platform-badge {
    font-size: 12px;
    font-weight: 700;
    color: #2D5F3F;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  /* Platform-specific hover colors for logo text only */
  .platform-card.amazon:hover .platform-logo {
    color: #FF9900;
  }

  .platform-card.flipkart:hover .platform-logo {
    color: #2874F0;
  }

  .platform-card.meesho:hover .platform-logo {
    color: #8B008B;
  }

  .platform-card.website:hover .platform-logo {
    color: #2D5F3F;
  }

  .platforms-bottom-cta {
    margin-top: 20px;
    padding: 20px;
    background: #FFF9F3;
    border-radius: 8px;
    text-align: center;
  }

  .platforms-bottom-cta p {
    font-size: 13px;
    color: #6B5D4F;
    font-weight: 500;
    margin: 0;
  }

  @media (max-width: 768px) {
    .platforms-grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .platform-card {
      padding: 30px 16px;
    }

    .platform-logo {
      font-size: 22px;
    }

    .platforms-title {
      font-size: calc({{ section.settings.title_size }}px * 0.8);
    }
  }
</style>

{% schema %}
{
  "name": "Platforms Section",
  "settings": [
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding",
      "min": 40,
      "max": 120,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F5EDE4"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "default": "SHOP YOUR WAY"
    },
    {
      "type": "color",
      "id": "kicker_color",
      "label": "Kicker Color",
      "default": "#8B7355"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Available Wherever You Shop"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 28,
      "max": 56,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#2C2416"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Choose your preferred shopping platform — same quality, same freshness, delivered to your door"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#6B5D4F"
    },
    {
      "type": "header",
      "content": "Platform Cards"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "hover_badge_color",
      "label": "Badge Color on Hover",
      "default": "#3D5F4A"
    },
    {
      "type": "header",
      "content": "Special Badge"
    },
    {
      "type": "color",
      "id": "special_badge_bg",
      "label": "Special Badge Background",
      "default": "#FFD700"
    },
    {
      "type": "color",
      "id": "special_badge_text",
      "label": "Special Badge Text",
      "default": "#2C2416"
    },
    {
      "type": "header",
      "content": "Bottom CTA"
    },
    {
      "type": "textarea",
      "id": "bottom_cta",
      "label": "Bottom CTA Text (optional)",
      "default": "💚 Buying direct? You get the freshest batches, best prices, and support our small team."
    },
    {
      "type": "color",
      "id": "bottom_cta_color",
      "label": "Bottom CTA Color",
      "default": "#6B5D4F"
    }
  ],
  "blocks": [
    {
      "type": "platform",
      "name": "Platform Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Platform Logo Image (optional)",
          "info": "Upload platform logo. If not provided, text name will be shown."
        },
        {
          "type": "text",
          "id": "logo_text",
          "label": "Platform Name",
          "default": "Amazon"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Platform Link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in New Tab",
          "default": true
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "Shop Now →"
        },
        {
          "type": "select",
          "id": "platform_class",
          "label": "Platform Style",
          "options": [
            {"value": "amazon", "label": "Amazon (Orange)"},
            {"value": "flipkart", "label": "Flipkart (Blue)"},
            {"value": "meesho", "label": "Meesho (Purple)"},
            {"value": "website", "label": "Website (Green)"}
          ],
          "default": "amazon"
        },
        {
          "type": "text",
          "id": "special_badge",
          "label": "Special Badge (optional, e.g., 'Best Price')",
          "info": "Leave empty for no special badge"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Platforms Section",
      "blocks": [
        {
          "type": "platform",
          "settings": {
            "logo_text": "Amazon",
            "badge_text": "Shop Now →",
            "platform_class": "amazon",
            "new_tab": true
          }
        },
        {
          "type": "platform",
          "settings": {
            "logo_text": "Flipkart",
            "badge_text": "Shop Now →",
            "platform_class": "flipkart",
            "new_tab": true
          }
        },
        {
          "type": "platform",
          "settings": {
            "logo_text": "Meesho",
            "badge_text": "Shop Now →",
            "platform_class": "meesho",
            "new_tab": true
          }
        },
        {
          "type": "platform",
          "settings": {
            "logo_text": "CutCraving.com",
            "badge_text": "⭐ Direct",
            "platform_class": "website",
            "special_badge": "Best Price",
            "new_tab": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
