<section class="cta-section">
  <div class="cta-container">
    <div class="cta-box">
      <h2 class="cta-title">{{ section.settings.title }}</h2>
      <p class="cta-subtitle">{{ section.settings.subtitle }}</p>
      {% if section.settings.incentive %}
        <p class="cta-incentive">{{ section.settings.incentive }}</p>
      {% endif %}
      <a href="{{ section.settings.cta_link }}" class="cta-button">{{ section.settings.cta_text }}</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 80px 5%;
    background: #F5EDE4;  /* Warm beige background like original */
    text-align: center;
  }

  .cta-container {
    max-width: 700px;  /* 700px like original, not 900px */
    margin: 0 auto;
  }

  .cta-box {
    background: white;  /* White background like original */
    padding: 60px 40px;  /* Fixed padding like original */
    border-radius: 16px;  /* 16px like original, not 24px */
    text-align: center;
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
  }

  .cta-title {
    font-family: 'Playfair Display', serif;
    font-size: 38px;  /* 38px like original, not 42px */
    font-weight: 700;  /* 700 like original, not 800 */
    color: {{ section.settings.title_color }};
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .cta-subtitle {
    font-size: 16px;  /* 16px like original, not 18px */
    color: {{ section.settings.subtitle_color }};
    margin-bottom: 12px;  /* 12px like original, not 16px */
    line-height: 1.6;
  }

  .cta-incentive {
    font-size: 14px;  /* 14px like original, not 15px */
    color: #2D5F3F;  /* Primary green like original */
    margin-bottom: 32px;
    font-weight: 600;
    line-height: 1.6;
  }

  .cta-button {
    display: inline-block;
    padding: 16px 48px;  /* 16px 48px like original, not 20px 48px */
    background: #2D5F3F;  /* Solid green like original, not gradient */
    color: white;
    border-radius: 6px;  /* 6px rounded rectangle like original, not 60px pill */
    text-decoration: none;
    font-size: 18px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: all 0.3s;
  }

  .cta-button:hover {
    background: #234a31;  /* Darker green on hover */
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(45, 95, 63, 0.3);
  }

  @media (max-width: 768px) {
    .cta-box {
      padding: 40px 24px;  /* Reduced padding for mobile */
    }

    .cta-title {
      font-size: 28px;  /* Smaller on mobile */
    }

    .cta-subtitle {
      font-size: 15px;  /* Smaller on mobile */
    }

    .cta-incentive {
      font-size: 13px;  /* Smaller on mobile */
    }

    .cta-button {
      padding: 16px 40px;
      width: 100%;
      max-width: 320px;
    }
  }
</style>

{% schema %}
{
  "name": "Quiz CTA Section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Want to Control Your Cravings?"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#2C2416"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Take our 1-minute quiz & get your plan today"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#6B5D4F"
    },
    {
      "type": "textarea",
      "id": "incentive",
      "label": "Incentive Text (optional)",
      "default": "Get personalized product suggestions + exclusive offers"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Take Free Quiz →"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Quiz CTA Section"
    }
  ]
}
{% endschema %}
