<section class="routine-problem">
  <div class="routine-problem-container">
    <h2 class="routine-problem-title">{{ section.settings.title }}</h2>

    <div class="routine-problem-grid">
      {% for block in section.blocks %}
        <div class="routine-problem-card" {{ block.shopify_attributes }}>
          <div class="problem-icon">{{ block.settings.icon }}</div>
          <h3 class="problem-headline">{{ block.settings.headline }}</h3>
          <p class="problem-description">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .routine-problem {
    padding: 100px 5%;
    background: #F5EDE4;
  }

  .routine-problem-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .routine-problem-title {
    font-family: 'Playfair Display', serif;
    font-size: 38px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.3;
    margin: 0 0 60px 0;
    text-align: center;
  }

  .routine-problem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .routine-problem-card {
    background: white;
    padding: 40px 32px;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    text-align: center;
    transition: all 0.3s;
  }

  .routine-problem-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 8px 28px rgba(0,0,0,0.12);
  }

  .problem-icon {
    font-size: 52px;
    margin-bottom: 24px;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.1));
  }

  .problem-headline {
    font-size: 22px;
    font-weight: 700;
    color: #2C2416;
    margin: 0 0 12px 0;
  }

  .problem-description {
    font-size: 15px;
    color: #6B5D4F;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 900px) {
    .routine-problem-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 768px) {
    .routine-problem {
      padding: 60px 5%;
    }

    .routine-problem-title {
      font-size: 28px;
      margin-bottom: 40px;
    }

    .routine-problem-card {
      padding: 32px 24px;
    }

    .problem-icon {
      font-size: 44px;
    }
  }
</style>

{% schema %}
{
  "name": "Routine Problem",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Section Title",
      "default": "What usually goes wrong at this time"
    }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Problem Headline",
          "default": "Energy dips"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "3-5 PM fatigue kicks in."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine Problem",
      "blocks": [
        {
          "type": "problem",
          "settings": {
            "icon": "🥱",
            "headline": "You skip breakfast",
            "description": "No time. No appetite. You'll eat later."
          }
        },
        {
          "type": "problem",
          "settings": {
            "icon": "🍪",
            "headline": "You grab carbs",
            "description": "Muffin, toast, cereal. Quick sugar spike."
          }
        },
        {
          "type": "problem",
          "settings": {
            "icon": "📉",
            "headline": "11 AM hunger hits",
            "description": "Energy crashes. Cravings return stronger."
          }
        }
      ]
    }
  ]
}
{% endschema %}
