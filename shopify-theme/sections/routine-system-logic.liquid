<section class="routine-system-logic">
  <div class="routine-logic-container">
    <div class="routine-logic-content">
      <h2 class="routine-logic-title">{{ section.settings.title }}</h2>

      <div class="routine-logic-steps">
        {% for block in section.blocks %}
          <div class="logic-step" {{ block.shopify_attributes }}>
            <div class="step-number">{{ forloop.index }}</div>
            <div class="step-content">
              <h3 class="step-title">{{ block.settings.step_title }}</h3>
              {% if block.settings.step_description %}
                <p class="step-description">{{ block.settings.step_description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.show_insight %}
        <div class="routine-logic-insight">
          <div class="insight-icon">💡</div>
          <p>{{ section.settings.insight_text }}</p>
        </div>
      {% endif %}
    </div>

    {% if section.settings.visual_image %}
      <div class="routine-logic-visual">
        <img src="{{ section.settings.visual_image | img_url: '600x600' }}" alt="How this routine works" class="logic-visual-image">
      </div>
    {% endif %}
  </div>
</section>

<style>
  .routine-system-logic {
    padding: 100px 5%;
    background: #FFF9F3;
  }

  .routine-logic-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .routine-logic-title {
    font-family: 'Playfair Display', serif;
    font-size: 38px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.3;
    margin: 0 0 50px 0;
  }

  .routine-logic-steps {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 40px;
  }

  .logic-step {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .step-number {
    width: 44px;
    height: 44px;
    background: #2D5F3F;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .step-content {
    flex: 1;
    padding-top: 4px;
  }

  .step-title {
    font-size: 20px;
    font-weight: 700;
    color: #2C2416;
    margin: 0 0 8px 0;
  }

  .step-description {
    font-size: 15px;
    color: #6B5D4F;
    line-height: 1.7;
    margin: 0;
  }

  .routine-logic-insight {
    background: rgba(45, 95, 63, 0.08);
    padding: 24px 28px;
    border-radius: 12px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    border-left: 4px solid #2D5F3F;
  }

  .insight-icon {
    font-size: 24px;
    flex-shrink: 0;
  }

  .routine-logic-insight p {
    font-size: 16px;
    color: #2C2416;
    line-height: 1.7;
    margin: 0;
    font-weight: 600;
  }

  .routine-logic-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logic-visual-image {
    width: 100%;
    max-width: 450px;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.1));
    border-radius: 16px;
  }

  @media (max-width: 900px) {
    .routine-logic-container {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .routine-logic-visual {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .routine-system-logic {
      padding: 60px 5%;
    }

    .routine-logic-title {
      font-size: 28px;
      margin-bottom: 36px;
    }

    .step-number {
      width: 38px;
      height: 38px;
      font-size: 18px;
    }

    .logic-visual-image {
      max-width: 320px;
    }
  }
</style>

{% schema %}
{
  "name": "Routine System Logic",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Section Title",
      "default": "How this routine works"
    },
    {
      "type": "checkbox",
      "id": "show_insight",
      "label": "Show Insight Box",
      "default": true
    },
    {
      "type": "textarea",
      "id": "insight_text",
      "label": "Insight Text",
      "default": "This routine doesn't remove cravings. It satisfies the right one — at the right time."
    },
    {
      "type": "image_picker",
      "id": "visual_image",
      "label": "Visual Image (optional)"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Logic Step",
      "settings": [
        {
          "type": "text",
          "id": "step_title",
          "label": "Step Title",
          "default": "Identify the craving type"
        },
        {
          "type": "textarea",
          "id": "step_description",
          "label": "Step Description (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine System Logic",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_title": "Identify the craving type"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_title": "Replace (don't restrict) the habit"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_title": "Create a repeatable ritual"
          }
        }
      ]
    }
  ]
}
{% endschema %}
