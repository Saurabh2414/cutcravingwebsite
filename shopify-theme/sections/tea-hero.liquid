<section class="tea-hero">
  <div class="tea-hero-container">
    <div class="tea-hero-content">
      {% if section.settings.eyebrow_text %}
        <div class="tea-hero-eyebrow">{{ section.settings.eyebrow_text }}</div>
      {% endif %}

      <h1 class="tea-hero-headline">{{ section.settings.headline }}</h1>

      <p class="tea-hero-subline">{{ section.settings.subline }}</p>

      <div class="tea-hero-ctas">
        <a href="{{ section.settings.primary_cta_link }}" class="btn-tea-primary">
          <span class="btn-text">{{ section.settings.primary_cta_text | remove: '→' | strip }}</span>
          <span class="btn-arrow">→</span>
        </a>
        {% if section.settings.show_secondary_cta %}
          <a href="{{ section.settings.secondary_cta_link }}" class="btn-tea-secondary">
            {{ section.settings.secondary_cta_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="tea-hero-visual">
      {% if section.settings.hero_image %}
        <img src="{{ section.settings.hero_image | img_url: '1000x1000' }}" alt="{{ section.settings.headline | escape }}" loading="eager" class="tea-hero-image" id="teaCupImage">
      {% endif %}

      <!-- Steam Animation -->
      <svg class="tea-steam" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <path class="steam-path steam-1" d="M50,50 Q55,30 50,10" fill="none" stroke="rgba(173, 216, 230, 0.4)" stroke-width="2"/>
        <path class="steam-path steam-2" d="M40,50 Q35,30 40,10" fill="none" stroke="rgba(173, 216, 230, 0.3)" stroke-width="2"/>
        <path class="steam-path steam-3" d="M60,50 Q65,30 60,10" fill="none" stroke="rgba(173, 216, 230, 0.3)" stroke-width="2"/>
      </svg>

      <!-- Floating Butterfly Pea Flowers -->
      <div class="floating-flower flower-1">🦋</div>
      <div class="floating-flower flower-2">🌸</div>
      <div class="floating-flower flower-3">🦋</div>
    </div>
  </div>
</section>

<style>
  .tea-hero {
    padding: 100px 5% 80px;
    background: linear-gradient(135deg, #E8F4FF 0%, #F0E8FF 100%);
    position: relative;
    overflow: hidden;
  }

  .tea-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(173, 216, 230, 0.3) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .tea-hero-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .tea-hero-eyebrow {
    font-size: 13px;
    color: #6B5D4F;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .tea-hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.2;
    margin: 0 0 24px 0;
    letter-spacing: -0.5px;
  }

  .tea-hero-subline {
    font-size: 19px;
    color: #6B5D4F;
    line-height: 1.7;
    margin-bottom: 36px;
  }

  .tea-hero-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-tea-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 18px 42px;
    background: #2D5F3F;
    color: white;
    border-radius: 32px;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 4px 16px rgba(45, 95, 63, 0.25);
    position: relative;
    overflow: hidden;
  }

  .btn-tea-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .btn-tea-primary:hover::before {
    opacity: 1;
  }

  .btn-tea-primary:hover {
    background: #234a31;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(45, 95, 63, 0.4);
  }

  .btn-arrow {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    display: inline-block;
  }

  .btn-tea-primary:hover .btn-arrow {
    transform: translateX(4px);
  }

  .btn-tea-primary:active {
    transform: scale(0.97) translateY(-1px);
  }

  .btn-tea-secondary {
    display: inline-block;
    padding: 18px 42px;
    background: transparent;
    color: #2D5F3F;
    border: 2px solid #2D5F3F;
    border-radius: 32px;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.3s;
  }

  .btn-tea-secondary:hover {
    background: rgba(45, 95, 63, 0.1);
  }

  .tea-hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tea-hero-image {
    width: 100%;
    max-width: 550px;
    height: auto;
    filter: drop-shadow(0 12px 32px rgba(0,0,0,0.15));
    transition: all 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    animation: cupGlow 6s ease-in-out infinite;
  }

  .tea-hero-visual:hover .tea-hero-image {
    transform: scale(1.02);
    filter: drop-shadow(0 16px 40px rgba(0,0,0,0.2));
  }

  /* Steam Animation */
  .tea-steam {
    position: absolute;
    width: 80px;
    height: 150px;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0.6;
    pointer-events: none;
  }

  .steam-path {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: steamRise 6s ease-in-out infinite;
  }

  .steam-1 {
    animation-delay: 0s;
  }

  .steam-2 {
    animation-delay: 0.5s;
  }

  .steam-3 {
    animation-delay: 1s;
  }

  .tea-hero-visual:hover .steam-path {
    animation: steamRise 4s ease-in-out infinite;
  }

  /* Floating Flowers */
  .floating-flower {
    position: absolute;
    font-size: 28px;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.1));
    animation: floatFlower 8s ease-in-out infinite;
    pointer-events: none;
  }

  .flower-1 {
    top: 15%;
    right: 10%;
    animation-delay: 0s;
  }

  .flower-2 {
    bottom: 20%;
    left: 5%;
    animation-delay: 2s;
  }

  .flower-3 {
    top: 50%;
    right: 5%;
    animation-delay: 4s;
  }

  /* Keyframe Animations */
  @keyframes steamRise {
    0%, 100% {
      stroke-dashoffset: 100;
      opacity: 0;
    }
    10% {
      opacity: 0.6;
    }
    90% {
      opacity: 0;
    }
    50% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes floatFlower {
    0%, 100% {
      transform: translateY(0px);
      opacity: 0.7;
    }
    50% {
      transform: translateY(-12px);
      opacity: 0.9;
    }
  }

  @keyframes cupGlow {
    0%, 100% {
      filter: drop-shadow(0 12px 32px rgba(0,0,0,0.15));
    }
    50% {
      filter: drop-shadow(0 12px 32px rgba(0,0,0,0.18)) drop-shadow(0 0 20px rgba(173, 216, 230, 0.3));
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .tea-hero-image {
      animation: none !important;
    }

    .steam-path {
      animation: none !important;
      opacity: 0;
    }

    .floating-flower {
      animation: none !important;
    }

    .btn-arrow {
      transition: none !important;
    }

    .btn-tea-primary:hover .btn-arrow {
      transform: none !important;
    }

    .tea-hero-visual:hover .tea-hero-image {
      transform: none !important;
    }
  }

  @media (max-width: 900px) {
    .tea-hero-container {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .tea-hero-visual {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .tea-hero {
      padding: 60px 5% 50px;
    }

    .tea-hero-headline {
      font-size: 36px;
    }

    .tea-hero-subline {
      font-size: 17px;
    }

    .tea-hero-ctas {
      flex-direction: column;
    }

    .btn-tea-primary,
    .btn-tea-secondary {
      width: 100%;
      text-align: center;
    }

    .tea-hero-image {
      max-width: 400px;
    }
  }
</style>

{% schema %}
{
  "name": "Tea Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "Blue Tea"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "When you want something to sip—not something to snack."
    },
    {
      "type": "textarea",
      "id": "subline",
      "label": "Subline",
      "default": "A calming ritual for bored mouths and restless evenings."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "Start a Calm Ritual →"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_cta",
      "label": "Show Secondary CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "Add to Cart"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Tea Hero"
    }
  ]
}
{% endschema %}
