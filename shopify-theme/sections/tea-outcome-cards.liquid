{% render 'pdp-animations' %}

<section class="tea-outcomes-section">
  <div class="outcomes-container">
    <h2 class="outcomes-title animate-fade-up">{{ section.settings.title }}</h2>

    <div class="outcomes-grid">
      {% for block in section.blocks %}
        <div class="outcome-card animate-stagger delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="outcome-icon">{{ block.settings.icon }}</div>
          <h3 class="outcome-heading">{{ block.settings.heading }}</h3>
          <p class="outcome-description">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .tea-outcomes-section {
    padding: 100px 5%;
    background: #FFFFFF;
  }

  .outcomes-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .outcomes-title {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    font-weight: 700;
    color: #2C2416;
    text-align: center;
    margin: 0 0 60px 0;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  .outcomes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .outcome-card {
    background: #F8F9FB;
    padding: 40px 32px;
    border-radius: 12px;
    text-align: center;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
  }

  .outcome-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .outcome-icon {
    font-size: 52px;
    margin-bottom: 24px;
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    display: inline-block;
  }

  .outcome-card:hover .outcome-icon {
    transform: scale(1.1);
  }

  .outcome-heading {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
    color: #2C2416;
    margin: 0 0 12px 0;
    line-height: 1.3;
    transition: opacity 0.3s;
  }

  .outcome-description {
    font-size: 15px;
    color: #6B5D4F;
    line-height: 1.7;
    margin: 0;
    transition: opacity 0.3s;
  }

  /* Icon animates first, then text */
  .outcome-card:not(.in-view) .outcome-icon {
    opacity: 0;
    transform: translateY(20px);
  }

  .outcome-card:not(.in-view) .outcome-heading,
  .outcome-card:not(.in-view) .outcome-description {
    opacity: 0;
  }

  .outcome-card.in-view .outcome-icon {
    animation: iconAppear 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .outcome-card.in-view .outcome-heading {
    animation: textAppear 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards;
  }

  .outcome-card.in-view .outcome-description {
    animation: textAppear 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.25s forwards;
  }

  @keyframes iconAppear {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes textAppear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .outcome-card {
      transition: none;
    }

    .outcome-card:hover {
      transform: none;
    }

    .outcome-icon {
      transition: none;
    }

    .outcome-card:hover .outcome-icon {
      transform: none;
    }

    .outcome-card:not(.in-view) .outcome-icon,
    .outcome-card:not(.in-view) .outcome-heading,
    .outcome-card:not(.in-view) .outcome-description {
      opacity: 1;
    }

    .outcome-card.in-view .outcome-icon,
    .outcome-card.in-view .outcome-heading,
    .outcome-card.in-view .outcome-description {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .outcomes-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 768px) {
    .tea-outcomes-section {
      padding: 70px 5%;
    }

    .outcomes-title {
      font-size: 32px;
      margin-bottom: 40px;
    }

    .outcome-card {
      padding: 32px 24px;
    }

    .outcome-icon {
      font-size: 44px;
      margin-bottom: 20px;
    }

    .outcome-heading {
      font-size: 20px;
    }

    .outcome-description {
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Tea Outcome Cards",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Section Title",
      "default": "What actually changes"
    }
  ],
  "blocks": [
    {
      "type": "outcome",
      "name": "Outcome Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji)",
          "default": "🧘"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Outcome Heading",
          "default": "Evening cravings quiet down"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Your hands and mouth stay busy without reaching for snacks"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tea Outcome Cards",
      "blocks": [
        {
          "type": "outcome",
          "settings": {
            "icon": "🧘",
            "heading": "Evening cravings quiet down",
            "description": "Your hands and mouth stay busy without reaching for snacks"
          }
