<section class="tea-preparation tea-preparation-chamomile">
  <div class="tea-prep-container">
    <h2 class="tea-prep-title">{{ section.settings.title }}</h2>
    <p class="tea-prep-subtitle">{{ section.settings.subtitle }}</p>

    <div class="tea-prep-steps">
      {% for block in section.blocks %}
        <div class="tea-prep-step" {{ block.shopify_attributes }}>
          <div class="tea-step-number">{{ forloop.index }}</div>
          <div class="tea-step-content">
            <h3 class="tea-step-title">{{ block.settings.step_title }}</h3>
            <p class="tea-step-description">{{ block.settings.step_description }}</p>
          </div>
          {% if block.settings.step_image %}
            <div class="tea-step-visual">
              <img src="{{ block.settings.step_image | img_url: '300x300' }}" alt="{{ block.settings.step_title | escape }}" class="tea-step-image">
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_note %}
      <div class="tea-prep-note">
        <span class="note-icon">💡</span>
        <p>{{ section.settings.note_text }}</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .tea-preparation-chamomile {
    padding: 100px 5%;
    background: linear-gradient(135deg, #FFF9E8 0%, #FFF4E0 100%);
  }

  .tea-preparation-chamomile .tea-prep-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .tea-preparation-chamomile .tea-prep-title {
    font-family: 'Playfair Display', serif;
    font-size: 38px;
    font-weight: 700;
    color: #2C2416;
    line-height: 1.3;
    margin: 0 0 16px 0;
    text-align: center;
  }

  .tea-preparation-chamomile .tea-prep-subtitle {
    font-size: 17px;
    color: #6B5D4F;
    text-align: center;
    margin-bottom: 60px;
    font-style: italic;
  }

  .tea-preparation-chamomile .tea-prep-steps {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-bottom: 50px;
  }

  .tea-preparation-chamomile .tea-prep-step {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 28px;
    align-items: center;
    background: white;
    padding: 32px;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    transition: all 0.3s;
  }

  .tea-preparation-chamomile .tea-prep-step:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 28px rgba(0,0,0,0.12);
  }

  .tea-preparation-chamomile .tea-step-number {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #D4A017 0%, #B8860B 100%);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .tea-preparation-chamomile .tea-step-content {
    flex: 1;
  }

  .tea-preparation-chamomile .tea-step-title {
    font-size: 20px;
    font-weight: 700;
    color: #2C2416;
    margin: 0 0 8px 0;
  }

  .tea-preparation-chamomile .tea-step-description {
    font-size: 15px;
    color: #6B5D4F;
    line-height: 1.7;
    margin: 0;
  }

  .tea-preparation-chamomile .tea-step-visual {
    flex-shrink: 0;
  }

  .tea-preparation-chamomile .tea-step-image {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 12px;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.1));
  }

  .tea-preparation-chamomile .tea-prep-note {
    background: rgba(212, 160, 23, 0.08);
    padding: 24px 28px;
    border-radius: 12px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    border-left: 4px solid #D4A017;
  }

  .tea-preparation-chamomile .note-icon {
    font-size: 24px;
    flex-shrink: 0;
  }

  .tea-preparation-chamomile .tea-prep-note p {
    font-size: 15px;
    color: #2C2416;
    line-height: 1.7;
    margin: 0;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .tea-preparation-chamomile {
      padding: 60px 5%;
    }

    .tea-preparation-chamomile .tea-prep-title {
      font-size: 28px;
    }

    .tea-preparation-chamomile .tea-prep-step {
      grid-template-columns: auto 1fr;
      gap: 20px;
      padding: 24px;
    }

    .tea-preparation-chamomile .tea-step-visual {
      grid-column: 1 / -1;
      text-align: center;
    }

    .tea-preparation-chamomile .tea-step-image {
      width: 100px;
      height: 100px;
    }

    .tea-preparation-chamomile .tea-step-number {
      width: 40px;
      height: 40px;
      font-size: 18px;
    }
  }
</style>

{% schema %}
{
  "name": "Tea Prep - Chamomile",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Section Title",
      "default": "A 5-minute ritual, not a recipe."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Not steps. Moments."
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show Note Section",
      "default": true
    },
    {
      "type": "textarea",
      "id": "note_text",
      "label": "Note Text",
      "default": "The golden color and gentle aroma are part of the experience. Breathe it in."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Preparation Step",
      "settings": [
        {
          "type": "text",
          "id": "step_title",
          "label": "Step Title",
          "default": "Take a pause"
        },
        {
          "type": "textarea",
          "id": "step_description",
          "label": "Step Description",
          "default": "Add chamomile flowers to your cup. This isn't about precision."
        },
        {
          "type": "image_picker",
          "id": "step_image",
          "label": "Step Image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tea Prep - Chamomile",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_title": "Take a pause",
            "step_description": "Add chamomile flowers to your cup. This isn't about precision."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_title": "Watch the color bloom",
            "step_description": "Pour hot water. Watch the golden hue unfold. This is the calming part."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_title": "Sip slowly",
            "step_description": "No gulping. No scrolling. Just sip."
          }
        }
      ]
    }
  ]
}
{% endschema %}
