      "default": "You don't lack discipline."
    },
    {
      "type": "textarea",
      "id": "silence_2",
      "label": "Second Statement",
      "default": "You lack food that works with your body."
    },
    {
      "type": "range",
      "id": "moment_text_size",
      "label": "Statement Text Size",
