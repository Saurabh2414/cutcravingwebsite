      "max": 40,
      "step": 2,
      "default": 26,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "primary_text_color",
      "label": "First Statement Color",
      "default": "#2d2d2d"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Second Statement Color",
      "default": "#3d5f4a"
    },
    {
      "type": "header",
      "content": "Interruption (The Problem)"
    },
    {
      "type": "text",
      "id": "interruption_label",
      "label": "Label",
      "default": "Most food does this:"
    },
    {
      "type": "text",
      "id": "interruption_text",
      "label": "Problem Statement",
      "default": "Spike → Crash → Crave → Repeat"
    },
    {
      "type": "textarea",
      "id": "interruption_subtext",
