      "label": "CTA Link"
    },
    {
      "type": "color",
      "id": "cta_bg_start",
      "label": "CTA Button Background Start",
      "default": "#3d5f4a"
    },
    {
      "type": "color",
      "id": "cta_bg_end",
      "label": "CTA Button Background End",
      "default": "#2d4a38"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA Button Text Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "value_prop",
      "name": "Value Proposition",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🥜"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Fill"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Unforgettable Moment",
      "blocks": [
        {
          "type": "value_prop",
          "settings": {
            "icon": "🥜",
            "label": "Fill"
          }
        },
        {
          "type": "value_prop",
          "settings": {
            "icon": "🌿",
