<section class="craving-interruption" style="padding: 48px 6%; background: {{ section.settings.background_color }}; min-height: 60vh; display: flex; align-items: center; justify-content: center;">
  <div style="text-align: center; max-width: 400px; margin: 0 auto;">

    <!-- Silence 1 -->
    <div id="silence1-{{ section.id }}" class="reveal-step">
      <p class="moment-text primary">{{ section.settings.silence_1 }}</p>
    </div>

    <!-- Silence 2 -->
    <div id="silence2-{{ section.id }}" class="reveal-step">
      <p class="moment-text accent">{{ section.settings.silence_2 }}</p>
    </div>

    <!-- Interruption -->
    <div id="interruption-{{ section.id }}" class="reveal-step" style="margin-bottom: 32px;">
      <p class="helper-text">{{ section.settings.interruption_label }}</p>

      <div class="interruption-card">
        <p class="interruption-text">{{ section.settings.interruption_text }}</p>
      </div>

      <p class="interruption-subtext">{{ section.settings.interruption_subtext }}</p>
    </div>

    <!-- Resolution -->
    <div id="resolution-{{ section.id }}" class="reveal-step" style="margin-bottom: 32px;">
      <p class="resolution-title">{{ section.settings.resolution_title }}</p>

      <div style="display: flex; justify-content: center; gap: 32px; margin-bottom: 32px;">
        {% for block in section.blocks %}
          {% if block.type == 'value_prop' %}
            <div style="text-align: center;" {{ block.shopify_attributes }}>
              <div style="font-size: 32px; margin-bottom: 8px;">{{ block.settings.icon }}</div>
              <p style="font-size: 16px; font-weight: 700; color: #2d2d2d; margin: 0;">{{ block.settings.label }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Soft CTA -->
    <div id="softCTA-{{ section.id }}" class="reveal-step">
      <p class="cta-helper">{{ section.settings.cta_helper }}</p>
      <a href="{{ section.settings.cta_link }}" class="soft-cta-button">
        {{ section.settings.cta_text }} →
      </a>
    </div>

  </div>
</section>

<style>
  .craving-interruption {
    padding: 48px 6%;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reveal-step {
    opacity: 0;
    transform: translateY(12px);
    transition: all 0.8s ease-out;
  }

  .reveal-step.active {
    opacity: 1;
    transform: translateY(0);
  }

  .moment-text {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.moment_text_size }}px;
    font-weight: 700;
    margin-bottom: 48px;
    line-height: 1.4;
  }

  .moment-text.primary {
    color: {{ section.settings.primary_text_color }};
  }

  .moment-text.accent {
    color: {{ section.settings.accent_text_color }};
    margin-bottom: 56px;
  }

  .helper-text {
    font-size: 15px;
    color: #7a7a7a;
    margin-bottom: 20px;
    font-weight: 500;
  }

  .interruption-card {
    background: white;
    padding: 24px;
    border-radius: 20px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    margin-bottom: 20px;
  }

  .interruption-text {
    font-size: 18px;
    font-weight: 700;
    color: #2d2d2d;
    margin: 0;
    line-height: 1.6;
  }

  .interruption-subtext {
    font-size: 15px;
    color: #5a5a5a;
    line-height: 1.6;
    font-style: italic;
  }

  .resolution-title {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
    color: #2d2d2d;
    margin-bottom: 28px;
    line-height: 1.4;
  }

  .cta-helper {
    font-size: 16px;
    color: #5a5a5a;
    margin-bottom: 20px;
  }

  .soft-cta-button {
    display: inline-block;
    padding: 16px 32px;
    background: #2D5F3F;  /* Solid green like original, not gradient */
    color: white;
    border-radius: 6px;  /* 6px rounded rectangle like original, not 60px pill */
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    box-shadow: 0 6px 16px rgba(61,95,74,0.25);
    transition: transform 0.3s;
  }

  .soft-cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(61,95,74,0.35);
  }

  @media (max-width: 768px) {
    .moment-text {
      font-size: calc({{ section.settings.moment_text_size }}px * 0.9);
    }
  }
</style>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const silence1 = document.getElementById(`silence1-${sectionId}`);
    const silence2 = document.getElementById(`silence2-${sectionId}`);
    const interruption = document.getElementById(`interruption-${sectionId}`);
    const resolution = document.getElementById(`resolution-${sectionId}`);
    const softCTA = document.getElementById(`softCTA-${sectionId}`);

    let triggered = false;

    function revealMoment() {
      if (triggered) return;

      const section = silence1.closest('.craving-interruption');
      if (!section) return;

      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight || document.documentElement.clientHeight;

      // Trigger when section is 50% visible
      if (rect.top <= windowHeight * 0.5) {
        triggered = true;

        // Progressive revelation
        setTimeout(() => silence1.classList.add('active'), 200);
        setTimeout(() => silence2.classList.add('active'), 1400);
        setTimeout(() => interruption.classList.add('active'), 2800);
        setTimeout(() => resolution.classList.add('active'), 4200);
        setTimeout(() => softCTA.classList.add('active'), 5600);
      }
    }

    window.addEventListener('scroll', revealMoment);
    setTimeout(revealMoment, 100);
  })();
</script>

{% schema %}
{
  "name": "Unforgettable Moment",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f6f3"
    },
    {
      "type": "header",
      "content": "Silence Statements"
    },
    {
