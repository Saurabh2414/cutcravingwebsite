      "default": "CutCraving was designed to interrupt cravings."
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_helper",
      "label": "CTA Helper Text",
      "default": "Start with one better choice."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "See what fits my day"
    },
    {
      "type": "url",
