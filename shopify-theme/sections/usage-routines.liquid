<section class="usage-routines-section">
  <div class="usage-routines-container">
    <!-- Header -->
    <div class="section-header">
      <div class="section-kicker">{{ section.settings.kicker }}</div>
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <!-- Routine Cards -->
    <div class="routines-grid">
      {% for block in section.blocks %}
        {% if block.type == 'routine' %}
          <div class="routine-card{% if block.settings.reverse_layout %} reverse{% endif %}" {{ block.shopify_attributes }}>
            <div class="routine-visual {{ block.settings.visual_class }}">
              {% if block.settings.visual_image %}
                <img src="{{ block.settings.visual_image | img_url: '400x400' }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="routine-visual-image">
              {% else %}
                <div class="visual-peanut">{{ block.settings.icon }}</div>
              {% endif %}
              <div class="visual-label">{{ block.settings.visual_label }}</div>
            </div>
            <div class="routine-content">
              <div class="routine-badge">{{ block.settings.badge }}</div>
              <h3 class="routine-title">{{ block.settings.title }}</h3>
              <p class="routine-description">{{ block.settings.description }}</p>

              <div class="routine-benefits">
                {% if block.settings.benefit_1 %}<span class="benefit-tag">{{ block.settings.benefit_1 }}</span>{% endif %}
                {% if block.settings.benefit_2 %}<span class="benefit-tag">{{ block.settings.benefit_2 }}</span>{% endif %}
                {% if block.settings.benefit_3 %}<span class="benefit-tag">{{ block.settings.benefit_3 }}</span>{% endif %}
              </div>

              <div class="routine-personas">
                <strong>Perfect for:</strong> {{ block.settings.personas }}
              </div>

              <a href="{{ block.settings.cta_link }}" class="routine-cta">{{ block.settings.cta_text }}</a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Bottom CTA -->
    {% if section.settings.show_bottom_cta %}
      <div class="routines-bottom-cta">
        <h3>{{ section.settings.bottom_cta_title }}</h3>
        <p>{{ section.settings.bottom_cta_subtitle }}</p>
        <a href="{{ section.settings.bottom_cta_link }}" class="btn-secondary">{{ section.settings.bottom_cta_button }}</a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .usage-routines-section {
    padding: 80px 5%;
    background: #FFF9F3;  /* Cream-light background like original */
  }

  .usage-routines-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-kicker {
    font-size: 12px;
    letter-spacing: 2px;
    color: {{ section.settings.kicker_color }};
    font-weight: 700;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    margin: 0 0 16px 0;
    letter-spacing: -0.5px;
  }

  .section-subtitle {
    font-size: 18px;
    color: {{ section.settings.subtitle_color }};
    line-height: 1.6;
  }

  .routines-grid {
    display: grid;
    gap: 60px;
  }

  .routine-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transition: all 0.3s;
  }

  .routine-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
  }

  .routine-card.reverse {
    grid-template-columns: 1fr 1fr;
  }

  .routine-card.reverse .routine-content {
    order: -1;
  }

  .routine-visual {
    background: linear-gradient(135deg, #FFE5B4 0%, #FFDAB9 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0;  /* Remove padding to let image fill space */
    position: relative;
    min-height: 500px;  /* Ensure minimum height */
  }

  .routine-visual.evening-visual {
    background: linear-gradient(135deg, #E6E6FA 0%, #DDA0DD 100%);
  }

  .routine-visual.afternoon-visual {
    background: linear-gradient(135deg, #FFB6C1 0%, #FF69B4 100%);
  }

  .routine-visual.focus-visual {
    background: linear-gradient(135deg, #B0E0E6 0%, #4682B4 100%);
  }

  .visual-peanut {
    font-size: 120px;
    filter: drop-shadow(0 4px 16px rgba(0,0,0,0.15));
    position: relative;  /* Keep centered with flexbox parent */
    z-index: 1;
  }

  .routine-visual-image {
    width: 100%;
    height: 100%;
    object-fit: cover;  /* Cover the entire visual area */
    position: absolute;  /* Position absolutely to fill parent */
    top: 0;
    left: 0;
  }

  .visual-label {
    font-size: 24px;
    font-weight: 700;
    color: white;
    text-shadow: 0 2px 8px rgba(0,0,0,0.3);
    position: absolute;  /* Position over the image */
    bottom: 30px;  /* Position at bottom */
    left: 50%;
    transform: translateX(-50%);  /* Center horizontally */
    z-index: 2;  /* Ensure it's above the image */
  }

  .routine-content {
    padding: 50px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .routine-badge {
    display: inline-block;
    background: #F5EDE4;
    color: #2C2416;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
    align-self: flex-start;
  }

  .routine-title {
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    font-weight: 700;
    color: #2C2416;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .routine-description {
    font-size: 15px;
    color: #6B5D4F;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .routine-benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
  }

  .benefit-tag {
    background: white;
    border: 1.5px solid rgba(139, 111, 71, 0.2);
    color: #2C2416;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.3s;
  }

  .benefit-tag:hover {
    border-color: #2D5F3F;
    background: #2D5F3F;
    color: white;
    transform: scale(1.05);
  }

  .routine-personas {
    font-size: 14px;
    color: #6B5D4F;
    margin-bottom: 24px;
  }

  .routine-personas strong {
    color: #2C2416;
  }

  .routine-cta {
    display: inline-block;
    background: #2D5F3F;
    color: white;
    padding: 14px 28px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.3s;
    align-self: flex-start;
  }

  .routine-cta:hover {
    background: #234a31;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(45, 95, 63, 0.3);
  }

  .routines-bottom-cta {
    text-align: center;
    margin-top: 80px;
    padding: 50px 40px;
    background: white;  /* White background like original, not beige */
    border-radius: 16px;  /* 16px like original, not 20px */
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);  /* Add shadow like original */
  }

  .routines-bottom-cta h3 {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 800;
    color: #2C2416;
    margin: 0 0 12px 0;
  }

  .routines-bottom-cta p {
    font-size: 16px;
    color: #6B5D4F;
    margin-bottom: 24px;
  }

  .btn-secondary {
    display: inline-block;
    padding: 16px 32px;
    background: transparent;
    color: #3D5F4A;
    border: 2px solid #3D5F4A;
    border-radius: 6px;  /* 6px rounded rectangle like original, not 60px pill */
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    transition: all 0.3s;
  }

  .btn-secondary:hover {
    background: #3D5F4A;
    color: white;
  }

  @media (max-width: 768px) {
    .routine-card,
    .routine-card.reverse {
      grid-template-columns: 1fr;
      padding: 24px;
      gap: 24px;
    }

    .routine-card.reverse .routine-visual {
      order: 1;
    }

    .routine-card.reverse .routine-content {
      order: 2;
    }

    .routine-visual {
      padding: 0;  /* Keep full-cover on mobile too */
      min-height: 300px;  /* Smaller min-height for mobile */
    }

    .visual-peanut {
      font-size: 56px;
    }

    .routine-title {
      font-size: 24px;
    }

    .section-title {
      font-size: calc({{ section.settings.title_size }}px * 0.8);
    }

    .routines-bottom-cta {
      padding: 40px 24px;
    }
  }
</style>

