<section class="usp-anchor-section" style="padding: {{ section.settings.section_padding }}px 5%; background: {{ section.settings.background_color }};">
  <div class="usp-container">
    <!-- Main Anchor Card -->
    <div class="usp-anchor-card">
      <div class="usp-icon">{{ section.settings.main_icon }}</div>
      <h2 class="usp-title">{{ section.settings.title }}</h2>
      <p class="usp-description">{{ section.settings.description }}</p>

      <div class="usp-benefits">
        {% for block in section.blocks %}
          {% if block.type == 'benefit_pill' %}
            <span class="usp-pill" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.social_proof %}
        <div class="usp-social-proof">{{ section.settings.social_proof }}</div>
      {% endif %}
    </div>

    <!-- Supporting Proof Pills -->
    <div class="proof-pills-grid">
      {% for block in section.blocks %}
        {% if block.type == 'proof_card' %}
          <div class="proof-pill" {{ block.shopify_attributes }}>
            <div class="pill-icon">{{ block.settings.icon }}</div>
            <div class="pill-text">{{ block.settings.text }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .usp-anchor-section {
    padding: 80px 5%;
  }

  .usp-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .usp-anchor-card {
    background: {{ section.settings.card_bg_color }};
    padding: 60px 50px;
    border-radius: 24px;
    text-align: center;
    margin-bottom: 40px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.1);
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
  }

  .usp-icon {
    font-size: 72px;
    margin-bottom: 24px;
    line-height: 1;
  }

  .usp-title {
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    margin: 0 0 20px 0;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  .usp-description {
    font-size: 18px;
    color: {{ section.settings.description_color }};
    line-height: 1.7;
    margin: 0 auto 32px auto;
    max-width: 700px;
  }

  .usp-benefits {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 28px;
  }

  .usp-pill {
    display: inline-block;
    padding: 12px 24px;
    background: {{ section.settings.pill_bg_color }};
    color: {{ section.settings.pill_text_color }};
    border-radius: 30px;
    font-size: 15px;
    font-weight: 600;
    transition: all 0.3s;
    border: 2px solid transparent;
  }

  .usp-pill:hover {
    background: {{ section.settings.pill_hover_bg }};
    border-color: {{ section.settings.pill_hover_border }};
    transform: translateY(-2px);
  }

  .usp-social-proof {
    font-size: 16px;
    color: {{ section.settings.social_proof_color }};
    font-weight: 600;
  }

  .proof-pills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .proof-pill {
    background: {{ section.settings.proof_pill_bg }};
    padding: 32px 24px;
    border-radius: 16px;
    text-align: center;
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    transition: all 0.3s;
    border: 2px solid {{ section.settings.proof_pill_border }};
  }

  .proof-pill:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
    border-color: {{ section.settings.proof_pill_hover_border }};
  }

  .pill-icon {
    font-size: 48px;
    margin-bottom: 16px;
    line-height: 1;
  }

  .pill-text {
    font-size: 17px;
    font-weight: 700;
    color: {{ section.settings.proof_pill_text_color }};
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .usp-anchor-card {
      padding: 40px 30px;
    }

    .usp-icon {
      font-size: 56px;
    }

    .usp-title {
      font-size: calc({{ section.settings.title_size }}px * 0.75);
    }

    .usp-description {
      font-size: 16px;
    }

    .usp-benefits {
      flex-direction: column;
      align-items: center;
    }

    .usp-pill {
      padding: 10px 20px;
      font-size: 14px;
    }

    .proof-pills-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .proof-pill {
      padding: 24px 20px;
    }

    .pill-icon {
      font-size: 40px;
    }

    .pill-text {
      font-size: 16px;
    }
  }
</style>

